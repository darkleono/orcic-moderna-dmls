---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const menuItems = [
    { label: 'Dashboard', icon: 'dashboard', href: '/admin' },
    { label: 'Properties', icon: 'home_work', href: '/admin/properties' },
    { label: 'Featured Bento', icon: 'grid_view', href: '/admin/developments' },
    { label: 'Editorial Ethos', icon: 'edit_note', href: '/admin/content' },
];
---

<!doctype html>
<html lang="es" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Admin ORCIC</title>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
	</head>
	<body class="bg-[#eff1f5] font-['Inter'] text-slate-900 antialiased overflow-hidden h-screen flex">
        
        <!-- Sidebar -->
        <aside class="w-80 bg-white border-r border-slate-200 flex flex-col p-8 shrink-0">
            <div class="h-16 flex items-center mb-12">
                <span class="text-2xl font-heading font-black tracking-tighter">EstateArchitect <span class="text-orcic-blue">.</span></span>
            </div>
            
            <!-- Sidebar User Profile Block (STICH STYLE) -->
            <div class="bg-slate-50 border border-slate-100 p-6 rounded-[2rem] mb-10 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 border-2 border-white shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=Estate+Admin&background=041627&color=fff" class="w-full h-full object-cover">
                </div>
                <div>
                    <p class="text-sm font-black text-slate-900 leading-tight">Estate Admin</p>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">124 Properties</p>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 space-y-2">
                {menuItems.map(item => (
                    <a 
                        href={item.href} 
                        class={`flex items-center gap-5 px-6 py-4 rounded-2xl transition-all duration-300 font-bold ${Astro.url.pathname === item.href ? 'bg-[#21ba70]/10 text-[#21ba70]' : 'text-slate-400 hover:bg-slate-50 hover:text-slate-900'}`}
                    >
                        <span class="material-symbols-outlined text-2xl font-black">{item.icon}</span>
                        <span class="text-[10px] font-black uppercase tracking-[0.2em]">{item.label}</span>
                    </a>
                ))}
            </nav>

            <!-- Bottom Action Block -->
            <div class="mt-auto pt-8 border-t border-slate-100">
                <button class="w-full bg-[#041627] text-white py-5 rounded-2xl flex items-center justify-center gap-4 hover:bg-slate-900 transition-all shadow-2xl shadow-slate-900/20 mb-6">
                    <span class="material-symbols-outlined text-lg">add</span>
                    <span class="text-[11px] font-black uppercase tracking-widest">Add New Listing</span>
                </button>
                <a href="/admin/logout" class="flex items-center gap-5 px-6 py-2 text-slate-400 hover:text-red-500 transition-colors font-black text-[10px] uppercase tracking-widest">
                    <span class="material-symbols-outlined text-lg">logout</span>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 p-20 overflow-y-auto">
            
            <!-- Global Header -->
            <header class="flex justify-between items-center mb-16">
                <div>
                    <h1 class="text-5xl font-heading font-black text-slate-900 tracking-tighter leading-tight">Architectural Overview</h1>
                    <p class="text-slate-500 font-medium mt-2 text-lg">Welcome back, your portfolio is performing 12% better this month.</p>
                </div>
                
                <div class="flex items-center gap-4">
                    <div class="bg-at-surface-low border border-at-outline/20 px-6 py-4 rounded-xl flex items-center gap-4 shadow-sm">
                        <span class="material-symbols-outlined text-slate-400 text-xl">calendar_today</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-widest">Oct 24, 2024 - Nov 24, 2024</span>
                    </div>
                    <button class="bg-[#006d37] text-white px-8 py-4 rounded-xl font-bold text-[11px] uppercase tracking-widest hover:opacity-90 transition-all shadow-xl shadow-green-900/20">
                        Download Report
                    </button>
                </div>
            </header>

            <!-- Page Content -->
            <slot />
        </main>

		<style is:global>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			}
            ::-webkit-scrollbar { width: 6px; }
            ::-webkit-scrollbar-track { background: transparent; }
            ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
            ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
		</style>
	</body>
</html>
