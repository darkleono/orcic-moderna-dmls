---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const menuItems = [
    { label: 'Panel de Control', href: '/admin', icon: 'dashboard' },
    { label: 'Propiedades', href: '/admin/propiedades', icon: 'domain' },
    { label: 'Desarrollos', href: '/admin/desarrollos', icon: 'grid_view' },
    { label: 'Identidad Ethos', href: '/admin/contenido', icon: 'auto_stories' },
    { label: 'Mensajes', href: '/admin/mensajes', icon: 'chat_bubble' },
];
---

<!doctype html>
<html lang="es" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Admin ORCIC</title>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet"/>
	</head>
    <body class="bg-[#f9fafb] font-['Inter'] text-slate-900 antialiased overflow-hidden h-screen flex">
        
        <!-- Sidebar -->
        <aside class="w-72 bg-white border-r border-slate-100 flex flex-col px-8 py-14 shrink-0 relative z-50 overflow-hidden">
            <!-- Logo: Plain text, stich style -->
            <div class="mb-14 px-4">
                <span class="text-2xl font-heading font-extrabold tracking-tight text-slate-900 leading-none">EstateArchitect</span>
            </div>
            
            <!-- User Profile: Precise stich alignment -->
            <div class="flex items-center gap-4 mb-20 px-4">
                <div class="w-12 h-12 rounded-full overflow-hidden bg-slate-900 flex items-center justify-center shrink-0 shadow-sm border border-slate-100">
                    <img src="https://ui-avatars.com/api/?name=EA&background=041627&color=fff" class="w-full h-full object-cover">
                </div>
                <div class="flex flex-col">
                    <p class="text-[14px] font-bold text-slate-900 leading-none">Admin ORCIC</p>
                    <p class="text-[11px] text-slate-400 font-medium mt-1">Gestionando 124 Propiedades</p>
                </div>
            </div>

            <!-- Navigation: wide gap stich style -->
            <nav class="flex-1 space-y-4 px-2">
                {menuItems.map(item => (
                    <a 
                        href={item.href} 
                        class={`flex items-center gap-10 px-5 py-4 rounded-xl transition-all duration-300 ${Astro.url.pathname === item.href ? 'bg-slate-50 text-[#0056b3]' : 'text-slate-500 hover:text-slate-900'}`}
                    >
                        <span class="material-symbols-outlined text-2xl font-light">{item.icon}</span>
                        <span class="text-[14px] font-bold tracking-tight">{item.label}</span>
                    </a>
                ))}
            </nav>

            <!-- Bottom Action Block: Dark buttons stich alignment -->
            <div class="mt-auto pt-10 border-t border-slate-50 px-2">
                <button class="w-full bg-[#041627] text-white py-4 rounded-xl flex items-center justify-center gap-4 hover:bg-black transition-all mb-10 font-bold text-sm">
                    <span class="material-symbols-outlined text-lg">add</span>
                    <span class="tracking-tight">Nueva Propiedad</span>
                </button>
                <a href="/admin/logout" class="flex items-center gap-10 px-5 text-slate-400 hover:text-red-600 transition-colors font-bold text-sm">
                    <span class="material-symbols-outlined text-2xl font-light">logout</span>
                    <span class="tracking-tight">Cerrar Sesión</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 p-10 overflow-y-auto">
            
            <!-- Global Header (REFINED) -->
            <header class="flex justify-between items-center mb-10">
                <div>
                    <h1 class="text-4xl font-heading font-black text-slate-900 tracking-tighter leading-tight italic">Resumen Editorial</h1>
                    <p class="text-slate-500 font-medium text-base">Tu portafolio ha crecido un 12% este mes.</p>
                </div>
                
                <div class="flex items-center gap-4">
                    <div class="bg-white border border-slate-200 px-5 py-3 rounded-lg flex items-center gap-4 shadow-sm">
                        <span class="material-symbols-outlined text-slate-400 text-lg">calendar_today</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-widest">Oct 24, 2024 - Nov 24, 2024</span>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <slot />
        </main>

		<style is:global>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			}
            ::-webkit-scrollbar { width: 6px; }
            ::-webkit-scrollbar-track { background: transparent; }
            ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
            ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
		</style>
	</body>
</html>
