---
import Layout from '../../layouts/Layout.astro';
import type { Property } from '../../components/PropertyCard.astro';

export async function getStaticPaths() {
  const response = await fetch('https://orcic.mx/api-properties.php');
  const properties = await response.json();
  
  return properties.map((property: any) => ({
    params: { code: property.code },
    props: { property },
  }));
}

const { property } = Astro.props as { property: Property };

// Formateador de precio
const formatter = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  minimumFractionDigits: 0,
});

const formattedPrice = property.price ? formatter.format(parseFloat(property.price)) : "Consultar Precio";
---

<Layout title={`${property.name} | ORCIC`}>
    <!-- Header Spacing -->
    <div class="h-24"></div>

    <main class="bg-white min-h-screen">
        <!-- Hero Gallery -->
        <section class="container mx-auto px-6 py-8">
            <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-[600px]">
                <!-- Foto Principal -->
                <div class="md:col-span-2 md:row-span-2 rounded-3xl overflow-hidden group relative">
                    <img 
                        src={`https://orcic.mx/storage/${property.images[0]}`} 
                        alt={property.name}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
                    />
                    <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
                    <div class="absolute top-6 left-6 flex gap-2">
                        <span class="bg-orcic-blue text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-2xl">
                            {property.status}
                        </span>
                    </div>
                </div>
                
                <!-- Fotos Secundarias -->
                {property.images.slice(1, 5).map((img, index) => (
                    <div class={`rounded-3xl overflow-hidden group relative ${index >= 2 ? 'hidden lg:block' : ''}`}>
                        <img 
                            src={`https://orcic.mx/storage/${img}`} 
                            alt={`${property.name} gallery ${index + 1}`}
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
                        />
                        <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
                    </div>
                ))}

                <!-- Botón Ver Todo -->
                <div class="hidden lg:flex relative rounded-3xl overflow-hidden bg-slate-900 items-center justify-center cursor-pointer group">
                    <img 
                        src={`https://orcic.mx/storage/${property.images[property.images.length - 1]}`} 
                        class="absolute inset-0 w-full h-full object-cover opacity-30"
                        alt="Ver todas"
                    />
                    <div class="relative z-10 flex flex-col items-center gap-2">
                        <span class="material-symbols-outlined text-white text-3xl">grid_view</span>
                        <span class="text-white text-[10px] font-black uppercase tracking-widest">Ver Galería</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contenido Principal -->
        <section class="container mx-auto px-6 py-12">
            <div class="flex flex-col lg:flex-row gap-16">
                
                <!-- Columna Izquierda: Información -->
                <div class="lg:w-2/3">
                    <header class="mb-12">
                        <div class="flex items-center gap-3 text-slate-400 text-xs font-bold uppercase tracking-widest mb-4">
                            <span class="material-symbols-outlined text-sm">location_on</span>
                            {property.city} • <span class="text-orcic-blue">{property.category}</span>
                        </div>
                        <h1 class="text-5xl lg:text-6xl font-black font-['Manrope'] text-slate-900 mb-6 leading-tight">
                            {property.name}
                        </h1>
                        <p class="text-4xl font-black text-orcic-blue mb-4">
                            {property.price || property.value_property ? formatter.format(parseFloat(property.price || property.value_property)) : "Consultar Precio"}
                        </p>
                    </header>

                    <!-- Specs Bar -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-y border-slate-100 mb-12">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-orcic-blue bg-orcic-blue/5 p-4 rounded-2xl !text-3xl">bed</span>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Dormitorios</p>
                                <p class="text-lg font-black text-slate-900">{property.bedroom || property.num_rooms}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-orcic-blue bg-orcic-blue/5 p-4 rounded-2xl !text-3xl">bathtub</span>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Baños</p>
                                <p class="text-lg font-black text-slate-900">{property.bathroom || property.num_bathrooms}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-orcic-blue bg-orcic-blue/5 p-4 rounded-2xl !text-3xl">architecture</span>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Superficie</p>
                                <p class="text-lg font-black text-slate-900">{property.area} m²</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-orcic-blue bg-orcic-blue/5 p-4 rounded-2xl !text-3xl">tag</span>
                            <div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">ID</p>
                                <p class="text-lg font-black text-slate-900">{property.code}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="prose prose-slate max-w-none mb-16">
                        <h3 class="text-xl font-black font-['Manrope'] mb-6 uppercase tracking-widest text-slate-900">Detalles de la Propiedad</h3>
                        <div class="text-slate-600 leading-relaxed text-lg" set:html={property.description} />
                    </div>

                    <!-- Amenidades -->
                    <div class="mb-16">
                        <h3 class="text-xl font-black font-['Manrope'] mb-8 uppercase tracking-widest text-slate-900 border-b border-slate-100 pb-4">Amenidades y Características</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {property.features.map(feature => (
                                <div class="flex items-center gap-3 group">
                                    <span class="w-2 h-2 bg-orcic-blue rounded-full group-hover:scale-150 transition-transform"></span>
                                    <span class="text-slate-600 font-bold text-sm">{(feature as any).description || feature}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Sidebar Sticky -->
                <div class="lg:w-1/3">
                    <div class="sticky top-32">
                        <div class="bg-white rounded-[2.5rem] p-10 border border-slate-100 shadow-2xl relative overflow-hidden group">
                           <!-- Sutil gradiente de fondo -->
                            <div class="absolute top-0 right-0 w-32 h-32 bg-orcic-blue/5 rounded-full blur-3xl -mr-16 -mt-16"></div>

                            <h3 class="text-2xl font-black font-['Manrope'] text-slate-900 mb-3 uppercase tracking-tight">Interés Inmediato</h3>
                            <p class="text-slate-400 mb-8 font-semibold text-sm leading-relaxed tracking-tight">Reciba una atención personalizada por parte de nuestro consorcio.</p>
                            
                            <form class="space-y-4">
                                <input type="text" placeholder="Nombre completo" class="w-full bg-slate-50 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-orcic-blue outline-none transition-all font-bold text-sm" />
                                <input type="email" placeholder="Correo corporativo" class="w-full bg-slate-50 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-orcic-blue outline-none transition-all font-bold text-sm" />
                                <input type="tel" placeholder="WhatsApp / Teléfono" class="w-full bg-slate-50 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-orcic-blue outline-none transition-all font-bold text-sm" />
                                <textarea placeholder="Mensaje..." rows="3" class="w-full bg-slate-50 border-none rounded-2xl px-6 py-4 focus:ring-2 focus:ring-orcic-blue outline-none transition-all font-bold text-sm"></textarea>
                                
                                <button class="w-full bg-[#0b213b] text-white py-5 rounded-2xl font-black uppercase text-[10px] tracking-[0.4em] hover:bg-orcic-blue transition-all shadow-xl active:scale-95">
                                    Enviar solicitud
                                </button>
                            </form>

                            <div class="mt-8 pt-8 border-t border-slate-100">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest">Respuesta en 24h</span>
                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                                </div>
                                <a href="https://wa.me/529211234567" target="_blank" class="flex items-center justify-center gap-3 bg-[#25D366]/10 text-[#128C7E] py-5 rounded-2xl font-black text-[10px] uppercase tracking-[0.2em] hover:bg-[#25D366] hover:text-white transition-all">
                                    <span class="material-symbols-outlined !text-2xl">chat</span>
                                    WhatsApp Asesor
                                </a>
                            </div>
                        </div>

                        <!-- Badge de Confianza -->
                        <div class="mt-8 flex items-center justify-center gap-4 text-slate-400">
                            <span class="material-symbols-outlined text-4xl">verified_user</span>
                            <div class="text-[10px] uppercase font-black tracking-widest leading-tight">
                                Operación Protegida <br/>por ORCIC CONSORCIO
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Otras Propiedades (Opcional) -->
        <section class="bg-white py-24">
            <div class="container mx-auto px-6">
                <div class="h-px bg-slate-100 mb-24"></div>
                <!-- Aquí podríamos poner un carrusel de "Más propiedades en la zona" -->
            </div>
        </section>
    </main>

    <!-- Footer Space -->
    <div class="h-12 bg-white"></div>
</Layout>
