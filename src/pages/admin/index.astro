---
import AdminLayout from '../../layouts/AdminLayout.astro';

const stats = [
    { label: 'PROPIEDADES ACTIVAS', value: '84', icon: 'domain', color: 'bg-[#21ba70]', badge: '+4 this month', badgeColor: 'bg-[#21ba70]/10 text-[#21ba70]' },
    { label: 'LEADS NUEVOS', value: '312', icon: 'person_add', color: 'bg-[#f5af4d]', badge: 'New Leads', badgeColor: 'bg-[#f5af4d]/10 text-[#f5af4d]' },
    { label: 'VISITAS TOTALES', value: '12.5k', icon: 'visibility', color: 'bg-[#007bff]', badge: '+18% increase', badgeColor: 'bg-[#007bff]/10 text-[#007bff]' }
];

const activities = [
    { title: 'Nueva consulta de Lead', desc: '"Villa Serenity" - Carlos Ruiz', time: 'HACE 12 MIN', color: 'bg-[#21ba70]' },
    { title: 'Visita programada', desc: 'Penthouse Downtown - Mañana 10:00 AM', time: 'HACE 2 HORAS', color: 'bg-[#f5af4d]' },
    { title: 'Propiedad Vendida', desc: 'Casa del Bosque - Trámite finalizado', time: 'AYER', color: 'bg-slate-300' }
];
---

<AdminLayout title="Dashboard">
    <!-- Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">
        {stats.map(stat => (
            <div class="bg-white p-10 rounded-[2.5rem] shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-500 group">
                <div class="flex items-center gap-4 mb-10">
                    <div class={`${stat.color} w-14 h-14 rounded-2xl flex items-center justify-center text-white shadow-lg`}>
                        <span class="material-symbols-outlined text-2xl font-black">{stat.icon}</span>
                    </div>
                    <div class={`${stat.badgeColor} px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest`}>
                        {stat.badge}
                    </div>
                </div>
                <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mb-2">{stat.label}</p>
                <h3 class="text-6xl font-heading font-black text-slate-900 tracking-tighter">{stat.value}</h3>
            </div>
        ))}
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        
        <!-- Evolution Chart (2/3) -->
        <div class="lg:col-span-2 bg-at-surface-low rounded-[3rem] p-12 border border-at-outline/20">
            <div class="flex justify-between items-center mb-16">
                <h2 class="text-3xl font-heading font-black text-slate-900 tracking-tight leading-none">Evolución de Contactos</h2>
                <div class="bg-white px-5 py-3 rounded-xl shadow-sm text-[11px] font-black uppercase tracking-widest text-slate-500 border border-slate-100 cursor-pointer hover:bg-slate-50 transition-colors">
                    Last 6 Months
                </div>
            </div>

            <div class="h-80 flex items-end justify-between gap-6 px-4">
                {[25, 45, 55, 100, 70, 85, 90].map((height, i) => (
                    <div class="flex-1 flex flex-col items-center gap-6 group">
                        <div 
                            class={`w-full rounded-2xl transition-all duration-1000 ${i === 3 ? 'bg-at-secondary shadow-2xl shadow-at-secondary/30' : 'bg-slate-300/40 group-hover:bg-slate-300'}`} 
                            style={`height: ${height}%`}
                        ></div>
                        <span class={`text-[10px] font-black uppercase tracking-widest ${i === 3 ? 'text-at-secondary' : 'text-slate-400'}`}>
                            {['JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'][i]}
                        </span>
                    </div>
                ))}
            </div>
        </div>

        <!-- Recent Activity (1/3) -->
        <div class="bg-white rounded-[3rem] p-12 shadow-sm border border-slate-100">
            <h2 class="text-2xl font-heading font-black text-slate-900 tracking-tight mb-12">Actividad <br/> Reciente</h2>
            
            <div class="space-y-12 relative">
                <!-- Timeline V-Line -->
                <div class="absolute left-[19px] top-4 bottom-4 w-0.5 bg-slate-100"></div>

                {activities.map(item => (
                    <div class="flex gap-8 relative z-10">
                        <div class={`${item.color} w-10 h-10 rounded-full flex items-center justify-center text-white border-4 border-white shadow-md shrink-0`}>
                            <span class="material-symbols-outlined text-[16px] font-black">
                                {item.color.includes('21ba70') ? 'chat_bubble' : item.color.includes('f5af4d') ? 'event' : 'task_alt'}
                            </span>
                        </div>
                        <div class="flex flex-col">
                            <h4 class="font-black text-slate-900 text-sm leading-tight mb-1">{item.title}</h4>
                            <p class="text-slate-500 text-xs font-medium leading-relaxed">{item.desc}</p>
                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest mt-4">{item.time}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>

    </div>
</AdminLayout>
