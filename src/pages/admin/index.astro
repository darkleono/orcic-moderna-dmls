---
import AdminLayout from '../../layouts/AdminLayout.astro';

const stats = [
    { label: 'PROPIEDADES ACTIVAS', value: '84', icon: 'domain', color: 'bg-[#21ba70]', badge: '+4 this month', badgeColor: 'bg-[#21ba70]/10 text-[#21ba70]' },
    { label: 'LEADS NUEVOS', value: '312', icon: 'person_add', color: 'bg-[#f5af4d]', badge: 'New Leads', badgeColor: 'bg-[#f5af4d]/10 text-[#f5af4d]' },
    { label: 'VISITAS TOTALES', value: '12.5k', icon: 'visibility', color: 'bg-[#007bff]', badge: '+18% increase', badgeColor: 'bg-[#007bff]/10 text-[#007bff]' }
];

const activities = [
    { title: 'Nueva consulta de Lead', desc: '"Villa Serenity" - Carlos Ruiz', time: 'HACE 12 MIN', color: 'bg-[#21ba70]' },
    { title: 'Visita programada', desc: 'Penthouse Downtown - Mañana 10:00 AM', time: 'HACE 2 HORAS', color: 'bg-[#f5af4d]' },
    { title: 'Propiedad Vendida', desc: 'Casa del Bosque - Trámite finalizado', time: 'AYER', color: 'bg-slate-300' }
];
---

<AdminLayout title="Dashboard">
    <!-- Stats Row (COMPACT) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {stats.map(stat => (
            <div class="bg-white p-8 rounded-[1.5rem] shadow-sm border border-slate-100 hover:shadow-md transition-all duration-300 group">
                <div class="flex items-center gap-4 mb-6">
                    <div class={`${stat.color} w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-lg`}>
                        <span class="material-symbols-outlined text-xl font-black">{stat.icon}</span>
                    </div>
                    <div class={`${stat.badgeColor} px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest`}>
                        {stat.badge}
                    </div>
                </div>
                <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.2em] mb-1">{stat.label}</p>
                <h3 class="text-5xl font-heading font-black text-slate-900 tracking-tighter">{stat.value}</h3>
            </div>
        ))}
    </div>

    <!-- Main Content Grid (REFINED GAP) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Evolution Chart (2/3) -->
        <div class="lg:col-span-2 bg-[#f8fafc] rounded-[2rem] p-10 border border-slate-200 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-center mb-12 relative z-10">
                <div>
                    <h2 class="text-2xl font-heading font-black text-slate-900 tracking-tight leading-none italic">Evolución de Contactos</h2>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-2">Active Engagement analysis</p>
                </div>
                <div class="bg-white px-4 py-2 rounded-lg shadow-sm text-[10px] font-black uppercase tracking-widest text-slate-500 border border-slate-100 cursor-pointer hover:bg-slate-50 transition-colors">
                    Last 6 Months
                </div>
            </div>

            <div class="h-64 flex items-end justify-between gap-4 px-2 relative z-10">
                {[25, 45, 55, 100, 70, 85, 90].map((height, i) => (
                    <div class="flex-1 h-full flex flex-col justify-end items-center gap-4 group/bar">
                        <div 
                            class={`w-full max-w-[50px] rounded-xl transition-all duration-700 ${i === 3 ? 'bg-[#0056b3] shadow-xl shadow-blue-900/30' : 'bg-slate-300 group-hover/bar:bg-slate-400'}`} 
                            style={`height: ${height}%`}
                        ></div>
                        <span class={`text-[9px] font-black uppercase tracking-widest shrink-0 ${i === 3 ? 'text-[#0056b3]' : 'text-slate-400'}`}>
                            {['JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'][i]}
                        </span>
                    </div>
                ))}
            </div>
        </div>

        <!-- Recent Activity (1/3) -->
        <div class="bg-white rounded-[2rem] p-10 shadow-sm border border-slate-200 relative">
            <h2 class="text-xl font-heading font-black text-slate-900 tracking-tight mb-10 italic underline decoration-orcic-blue/20 underline-offset-4">Highlights</h2>
            
            <div class="space-y-8 relative">
                <!-- Timeline V-Line -->
                <div class="absolute left-[15px] top-4 bottom-4 w-px bg-slate-100"></div>

                {activities.map(item => (
                    <div class="flex gap-6 relative z-10">
                        <div class={`${item.color} w-8 min-w-[32px] h-8 rounded-full flex items-center justify-center text-white border-4 border-white shadow-sm shrink-0`}>
                            <span class="material-symbols-outlined text-[12px] font-black">
                                {item.color.includes('21ba70') ? 'chat_bubble' : item.color.includes('f5af4d') ? 'event' : 'task_alt'}
                            </span>
                        </div>
                        <div class="flex flex-col">
                            <h4 class="font-black text-slate-900 text-xs leading-tight mb-1">{item.title}</h4>
                            <p class="text-slate-500 text-[11px] font-medium leading-normal">{item.desc}</p>
                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest mt-2">{item.time}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</AdminLayout>
