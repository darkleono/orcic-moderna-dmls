---
import AdminLayout from '../../layouts/AdminLayout.astro';

const stats = [
    { label: 'Portafolio Global', value: '124', icon: 'domain', color: 'bg-[#041627]', badge: '+12%', badgeColor: 'bg-green-100 text-green-700' },
    { label: 'Prospectos Activos', value: '48', icon: 'person_search', color: 'bg-[#0056b3]', badge: 'High', badgeColor: 'bg-blue-100 text-blue-700' },
    { label: 'Visitas Agendadas', value: '12', icon: 'calendar_month', color: 'bg-[#21ba70]', badge: 'Hoy', badgeColor: 'bg-emerald-100 text-emerald-700' },
];

const activities = [
    { title: 'Nueva consulta de Lead', desc: '"Villa Serenity" - Carlos Ruiz', time: 'hace 12 min', color: 'bg-[#21ba70]' },
    { title: 'Visita programada', desc: 'Penthouse Downtown - Mañana 10:00 AM', time: 'hace 2 horas', color: 'bg-[#f5af4d]' },
    { title: 'Propiedad Vendida', desc: 'Casa del Bosque - Trámite finalizado', time: 'ayer', color: 'bg-slate-400' },
];
---

<AdminLayout title="Panel de Control">
    <!-- Stats Row (COMPACT) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {stats.map(stat => (
            <div class="bg-white p-8 rounded-[1.5rem] shadow-sm border border-slate-100 hover:shadow-md transition-all duration-300 group">
                <div class="flex items-center gap-4 mb-6">
                    <div class={`${stat.color} w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-lg`}>
                        <span class="material-symbols-outlined text-xl font-black">{stat.icon}</span>
                    </div>
                    <div class={`${stat.badgeColor} px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest`}>
                        {stat.badge}
                    </div>
                </div>
                <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.2em] mb-1">{stat.label}</p>
                <h3 class="text-5xl font-heading font-black text-slate-900 tracking-tighter">{stat.value}</h3>
            </div>
        ))}
    </div>

    <!-- Main Content Grid (REFINED GAP) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Evolution Chart (2/3) -->
        <div class="lg:col-span-2 bg-[#f8fafc] rounded-[2rem] p-10 border border-slate-200 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-center mb-12 relative z-10">
                <div>
                    <h2 class="text-2xl font-heading font-black text-slate-900 tracking-tight leading-none italic">Evolución de Contactos</h2>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-2">Análisis de interacción activa</p>
                </div>
                <div class="bg-white px-4 py-2 rounded-lg shadow-sm text-[10px] font-black uppercase tracking-widest text-slate-500 border border-slate-100 cursor-pointer hover:bg-slate-50 transition-colors">
                    Últimos 6 meses
                </div>
            </div>

            <div class="h-64 flex items-end justify-between gap-4 px-2 relative z-10">
                {[25, 45, 55, 100, 70, 85, 90].map((height, i) => (
                    <div class="flex-1 h-full flex flex-col justify-end items-center gap-4 group/bar">
                        <div 
                            class={`w-full max-w-[50px] rounded-xl transition-all duration-700 ${i === 3 ? 'bg-[#0056b3] shadow-xl shadow-blue-900/30' : 'bg-slate-300 group-hover/bar:bg-slate-400'}`} 
                            style={`height: ${height}%`}
                        ></div>
                        <span class={`text-[9px] font-black uppercase tracking-widest shrink-0 ${i === 3 ? 'text-[#0056b3]' : 'text-slate-400'}`}>
                            {['JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'][i]}
                        </span>
                    </div>
                ))}
            </div>
        </div>

        <!-- Recent Activity (1/3) -->
        <div class="bg-white rounded-[2rem] p-10 shadow-sm border border-slate-200 relative">
            <h2 class="text-xl font-heading font-black text-slate-900 tracking-tight mb-10 italic underline decoration-[#0056b3]/20 underline-offset-4">Destacados</h2>
            
            <div class="space-y-8 relative">
                <!-- Timeline V-Line -->
                <div class="absolute left-[15px] top-4 bottom-4 w-px bg-slate-100"></div>

                {activities.map(item => (
                    <div class="flex gap-6 relative z-10">
                        <div class={`${item.color} w-8 min-w-[32px] h-8 rounded-full flex items-center justify-center text-white border-4 border-white shadow-sm shrink-0`}>
                            <span class="material-symbols-outlined text-[12px] font-black">
                                {item.color.includes('21ba70') ? 'chat_bubble' : item.color.includes('f5af4d') ? 'event' : 'task_alt'}
                            </span>
                        </div>
                        <div class="flex flex-col">
                            <h4 class="font-black text-slate-900 text-xs leading-tight mb-1">{item.title}</h4>
                            <p class="text-slate-500 text-[11px] font-medium leading-normal">{item.desc}</p>
                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest mt-2">{item.time}</span>
                        </div>
                    </div>
                ))}
            </div>
            
            <button class="w-full mt-10 py-3 border border-slate-100 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-[#0056b3] hover:border-[#0056b3]/30 transition-all">
                Ver toda la actividad
            </button>
        </div>
    </div>

    <!-- Quick Inventory Management (NEW STICH SECTION) -->
    <div class="mt-10 bg-white rounded-[2.5rem] p-10 border border-slate-200 shadow-sm">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
            <h2 class="text-3xl font-heading font-black text-slate-900 tracking-tighter italic leading-none">Gestión Rápida de Inventario</h2>
            <div class="flex items-center gap-4">
                <button class="w-10 h-10 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-xl">filter_list</span>
                </button>
                <button class="w-10 h-10 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-xl">search</span>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 border-b border-slate-50">
                        <th class="pb-6 px-4">Propiedad</th>
                        <th class="pb-6 px-4">Estado</th>
                        <th class="pb-6 px-4">Vistas</th>
                        <th class="pb-6 px-4">Prospectos</th>
                        <th class="pb-6 px-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {[
                        { name: 'Sunset Heights Villa', loc: 'Malibu, CA', status: 'Disponible', statusCol: 'text-emerald-600 bg-emerald-50', views: '2,410', leads: '18', img: 'https://images.unsplash.com/photo-1600585154340-be6199fbf895?auto=format&fit=crop&w=150&q=80' },
                        { name: 'The Ironworks Loft', loc: 'Brooklyn, NY', status: 'Reservado', statusCol: 'text-orange-600 bg-orange-50', views: '1,890', leads: '5', img: 'https://images.unsplash.com/photo-1513584684374-8bdb74838a0f?auto=format&fit=crop&w=150&q=80' }
                    ].map(prop => (
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="py-5 px-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl overflow-hidden shadow-sm border border-slate-100">
                                        <img src={prop.img} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-black text-slate-900 text-sm">{prop.name}</span>
                                        <span class="text-[11px] font-medium text-slate-400 tracking-tight">{prop.loc}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-5 px-4">
                                <span class={`px-4 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest ${prop.statusCol}`}>
                                    {prop.status}
                                </span>
                            </td>
                            <td class="py-5 px-4 font-bold text-slate-600 text-sm">{prop.views}</td>
                            <td class="py-5 px-4 font-bold text-slate-600 text-sm">{prop.leads}</td>
                            <td class="py-5 px-4 text-right cursor-pointer">
                                <span class="material-symbols-outlined text-slate-300 hover:text-slate-900 transition-colors">more_vert</span>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-20 flex flex-col md:flex-row justify-between items-center py-10 border-t border-slate-100 gap-6">
        <p class="text-[10px] font-black text-slate-300 uppercase tracking-widest">© 2024 ESTATEARCHITECT. TODOS LOS DERECHOS RESERVADOS.</p>
        <nav class="flex gap-8 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">
            <a href="#" class="hover:text-[#0056b3] transition-colors">Política de Privacidad</a>
            <a href="#" class="hover:text-[#0056b3] transition-colors">Términos de Servicio</a>
            <a href="#" class="hover:text-[#0056b3] transition-colors">Accesibilidad</a>
        </nav>
    </footer>
</AdminLayout>
