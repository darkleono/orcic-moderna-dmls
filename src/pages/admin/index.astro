---
import AdminLayout from '../../layouts/AdminLayout.astro';

// FETCH DATA FOR STATS
let properties = [];
try {
    const response = await fetch('https://orcic.mx/api-properties.php');
    properties = await response.json();
    if ('error' in properties) properties = [];
} catch (e) {
    properties = [];
}

const stats = [
    { label: 'Propiedades Totales', value: properties.length, icon: 'home_work', color: 'blue' },
    { label: 'Desarrollos Activos', value: '12', icon: 'apartment', color: 'indigo' },
    { label: 'Leads Recientes', value: '48', icon: 'group', color: 'emerald' },
    { label: 'Visitas (Mes)', value: '1.2k', icon: 'trending_up', color: 'amber' },
];

const recentProperties = properties.slice(0, 5);
---

<AdminLayout title="Overview">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {stats.map((stat, i) => (
            <div class="bg-at-surface-lowest p-8 rounded-[2rem] transition-all duration-500 group relative shadow-sm border border-at-outline/5">
                <div class="flex justify-between items-start mb-6">
                    <div class={`p-4 rounded-2xl ${i === 0 ? 'bg-at-secondary/10 text-at-secondary' : i === 1 ? 'bg-at-tertiary/10 text-at-tertiary' : 'bg-orcic-blue/10 text-orcic-blue'}`}>
                        <span class="material-symbols-outlined text-2xl font-black">{stat.icon}</span>
                    </div>
                    <span class={`text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full ${i === 0 ? 'bg-at-secondary/10 text-at-secondary' : i === 1 ? 'bg-at-tertiary/10 text-at-tertiary' : 'bg-orcic-blue/10 text-orcic-blue'}`}>
                        {i === 0 ? '+4 this month' : i === 1 ? 'New Leads' : '+18% increase'}
                    </span>
                </div>
                <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.3em] font-black mb-1">{stat.label}</p>
                <div class="flex items-baseline gap-2">
                    <h3 class="text-4xl font-heading font-black text-on-surface tracking-tighter">{stat.value}</h3>
                </div>
            </div>
        ))}
    </div>

    <!-- Evolution & Activity Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Evolution Chart Placeholder -->
        <div class="lg:col-span-2 bg-at-surface-low rounded-[2.5rem] p-10">
            <div class="flex justify-between items-center mb-10">
                <h2 class="text-2xl font-heading font-black text-on-surface tracking-tight">Evolución de Contactos</h2>
                <select class="bg-at-surface-lowest border-none rounded-xl text-[10px] font-black uppercase tracking-widest py-2 px-4 shadow-sm outline-none">
                    <option>Last 6 Months</option>
                    <option>Last Year</option>
                </select>
            </div>
            
            <div class="h-64 flex items-end justify-between gap-4 px-4">
                {[25, 45, 60, 100, 70, 75, 85].map((height, i) => (
                    <div class="flex-1 group relative">
                         <div class={`w-full rounded-t-xl transition-all duration-700 ${i === 3 ? 'bg-at-secondary shadow-lg shadow-at-secondary/20' : 'bg-on-surface/5 group-hover:bg-on-surface/10'}`} style={`height: ${height}%`}></div>
                         {i === 3 && (
                             <div class="absolute -top-12 left-1/2 -translate-x-1/2 bg-on-surface text-at-surface-lowest text-[10px] font-black py-1.5 px-3 rounded-lg shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity">Peak: 420 leads</div>
                         )}
                    </div>
                ))}
            </div>
            <div class="flex justify-between mt-6 text-[10px] font-black text-on-surface-variant uppercase tracking-widest px-4 opacity-40">
                <span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span><span>Oct</span><span>Nov</span><span>Dec</span>
            </div>
        </div>

        <!-- Recent Activity Timeline -->
        <div class="bg-at-surface-lowest rounded-[2.5rem] p-10 border border-at-outline/5 shadow-sm">
            <h2 class="text-xl font-heading font-black text-on-surface tracking-tight mb-10">Actividad Reciente</h2>
            <div class="space-y-10 relative">
                 <!-- Timeline Line -->
                <div class="absolute left-[19px] top-2 bottom-2 w-[2px] bg-at-surface-low rounded-full"></div>
                
                {[
                    { title: 'Nueva consulta de Lead', desc: '"Villa Serenity" - Carlos Ruiz', time: 'Hace 12 min', icon: 'chat_bubble', color: 'bg-at-secondary' },
                    { title: 'Visita programada', desc: 'Penthouse Downtown - Mañana 10:00 AM', time: 'Hace 2 horas', icon: 'event', color: 'bg-at-tertiary' },
                    { title: 'Propiedad Vendida', desc: 'Casa del Bosque - Trámite finalizado', time: 'Ayer', icon: 'task_alt', color: 'bg-on-surface-variant' }
                ].map(item => (
                    <div class="flex gap-6 relative z-10">
                        <div class={`w-10 h-10 rounded-full ${item.color} flex items-center justify-center text-at-surface-lowest shadow-lg shadow-black/5`}>
                            <span class="material-symbols-outlined text-[16px]">{item.icon}</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-on-surface leading-tight">{item.title}</span>
                            <span class="text-xs text-on-surface-variant mt-1 font-medium">{item.desc}</span>
                            <span class="text-[9px] text-at-outline font-black uppercase tracking-widest mt-3">{item.time}</span>
                        </div>
                    </div>
                ))}
            </div>
            <button class="w-full mt-12 py-4 border-t border-at-surface-low text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant hover:text-orcic-blue transition-colors">View All Activities</button>
        </div>
    </div>

    <!-- Property Management Quick Table -->
    <div class="bg-at-surface-low rounded-[2.5rem] p-10 overflow-hidden">
        <div class="flex items-center justify-between mb-10 px-2">
            <h2 class="text-2xl font-heading font-black text-on-surface tracking-tight">Quick Inventory Management</h2>
            <div class="flex gap-2">
                <button class="w-10 h-10 rounded-xl bg-at-surface-lowest flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-all shadow-sm">
                    <span class="material-symbols-outlined text-xl">filter_list</span>
                </button>
                <button class="w-10 h-10 rounded-xl bg-at-surface-lowest flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-all shadow-sm">
                    <span class="material-symbols-outlined text-xl">search</span>
                </button>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-separate border-spacing-y-2">
                <thead>
                    <tr class="text-[10px] uppercase tracking-[0.2em] font-black text-on-surface-variant opacity-50">
                        <th class="pb-6 px-6">Property</th>
                        <th class="pb-6 px-6">Status</th>
                        <th class="pb-6 px-6 text-right">Utility</th>
                    </tr>
                </thead>
                <tbody>
                    {recentProperties.map(prop => (
                        <tr class="group">
                            <td class="py-4 px-6 bg-at-surface-lowest rounded-l-3xl transition-transform group-hover:-translate-y-0.5">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl bg-at-surface-low overflow-hidden shrink-0">
                                        {prop.image && <img src={prop.image} class="w-full h-full object-cover" />}
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-on-surface text-sm max-w-[200px] truncate">{prop.title || prop.name || 'Untitled'}</span>
                                        <span class="text-[11px] text-on-surface-variant font-medium">{prop.city}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 px-6 bg-at-surface-lowest transition-transform group-hover:-translate-y-0.5">
                                <span class="bg-at-secondary/10 text-at-secondary px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest">Available</span>
                            </td>
                            <td class="py-4 px-6 bg-at-surface-lowest rounded-r-3xl text-right transition-transform group-hover:-translate-y-0.5">
                                <button class="w-10 h-10 rounded-full hover:bg-at-surface-low flex items-center justify-center transition-colors text-on-surface-variant">
                                    <span class="material-symbols-outlined text-xl">more_vert</span>
                                </button>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

</AdminLayout>

