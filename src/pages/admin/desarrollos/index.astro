---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Mock data for featured developments in bento
const featuredDevelopments = [
    { id: 1, name: "Mérida Heritage", properties: 42, size: "Large (8x2)", image: "https://orcic.mx/storage/merida.jpg" },
    { id: 2, name: "Cancún Industrial", properties: 15, size: "Tall (4x4)", image: "https://orcic.mx/storage/cancun.jpg" },
    { id: 3, name: "Tulum Eco-Space", properties: 8, size: "Square (4x2)", image: "https://orcic.mx/storage/tulum.jpg" },
    { id: 4, name: "Valladolid Colonial", properties: 12, size: "Square (4x2)", image: "https://orcic.mx/storage/valladolid.jpg" }
];
---

<AdminLayout title="Inventario de Desarrollos">
    <div class="max-w-6xl">
        <!-- Header Actions -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-12 gap-8 px-2">
            <div>
                <p class="text-[#0056b3] font-black tracking-[0.4em] text-[10px] uppercase mb-3">Portafolio Maestro</p>
                <h2 class="text-4xl font-heading font-black text-slate-900 tracking-tighter italic leading-none">Desarrollos</h2>
            </div>
            <div class="flex gap-4">
                <button class="bg-[#041627] text-white px-8 py-3 rounded-xl font-bold text-[11px] uppercase tracking-widest hover:bg-black transition-all shadow-lg shadow-blue-900/10">
                    Nuevo Desarrollo
                </button>
            </div>
        </div>

        <!-- Development List Table -->
        <div class="bg-white border border-slate-200 rounded-[2.5rem] shadow-sm overflow-hidden p-4">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 border-b border-slate-50">
                        <th class="py-6 px-6">Identidad del Proyecto</th>
                        <th class="py-6 px-6">Tipo</th>
                        <th class="py-6 px-6">Unidades</th>
                        <th class="py-6 px-6">Estado</th>
                        <th class="py-6 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {[
                        { name: "Mérida Heritage", type: "Residencial", units: 42, status: "Ventas Activas", color: "text-emerald-600 bg-emerald-50", progress: 85, image: "https://orcic.mx/storage/merida.jpg" },
                        { name: "Cancún Industrial", type: "Industrial", units: 15, status: "Construcción", color: "text-blue-600 bg-blue-50", progress: 40, image: "https://orcic.mx/storage/cancun.jpg" },
                        { name: "Tulum Eco-Space", type: "Residencial", units: 8, status: "Sold Out", color: "text-slate-400 bg-slate-50", progress: 100, image: "https://orcic.mx/storage/tulum.jpg" },
                        { name: "Valladolid Colonial", type: "Comercial", units: 12, status: "Preventa", color: "text-orange-600 bg-orange-50", progress: 15, image: "https://orcic.mx/storage/valladolid.jpg" }
                    ].map(dev => (
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="py-6 px-6">
                                <div class="flex items-center gap-6">
                                    <div class="w-16 h-16 rounded-2xl overflow-hidden border border-slate-200 shadow-sm relative group-hover:scale-105 transition-transform duration-500">
                                        <img src={dev.image} class="w-full h-full object-cover" />
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-black text-slate-900 text-lg tracking-tight leading-none mb-1 group-hover:text-[#0056b3] transition-colors">{dev.name}</span>
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{dev.progress}% Completado</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-6 px-6">
                                <span class="bg-slate-100 text-slate-500 px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest">
                                    {dev.type}
                                </span>
                            </td>
                            <td class="py-6 px-6">
                                <span class="font-bold text-slate-600 text-sm">{dev.units} Activos</span>
                            </td>
                            <td class="py-6 px-6">
                                <span class={`px-4 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest shadow-sm border border-black/5 ${dev.color}`}>
                                    {dev.status}
                                </span>
                            </td>
                            <td class="py-6 px-6 text-right">
                                <div class="flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0">
                                    <button class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-[#0056b3] transition-all hover:shadow-lg">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                    </button>
                                    <button class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-red-500 transition-all hover:shadow-lg">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>
>
