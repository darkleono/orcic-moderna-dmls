---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import homeData from '/src/data/homeData.json';

// Datos de ejemplo para el Hero (Portada)
const homeHero = homeData.hero;

// Estadísticas de Impacto (Reales/Coherentes)
const impactStats = homeData.stats;

// Narrativa Editorial (FILOSOFÍA DIFERENTE AL HERO)
const ethosBlocks = homeData.ethos;
---

<AdminLayout title="Identidad Ethos">
    <!-- Base Canvas: surface (#f7f9fb) -->
    <div class="max-w-6xl mx-auto pb-20">
        
        <!-- Header: Manrope Display -->
        <div class="flex flex-col md:flex-row items-baseline justify-between mb-16 gap-8 px-4 lg:px-0">
            <div>
                <p class="text-[#041627] font-black tracking-[0.4em] text-[10px] uppercase mb-4 opacity-50">Narrativa de Marca</p>
                <h1 class="text-6xl font-heading font-black text-[#041627] tracking-tighter italic leading-none">Gestor de Contenido</h1>
            </div>
            <div class="flex gap-6">
                <button class="bg-[#006d37] text-white px-10 py-4 rounded-[0.75rem] font-black text-[11px] uppercase tracking-widest hover:brightness-110 transition-all shadow-xl shadow-emerald-900/10">
                    Sincronizar Cambios
                </button>
            </div>
        </div>

        <!-- Secondary Nav (Sub-secciones) -->
        <div class="flex gap-10 border-b border-[#041627]/5 mb-16 overflow-x-auto no-scrollbar px-4 lg:px-0">
            <a href="#hero" class="pb-6 border-b-2 border-[#041627] text-[#041627] text-[10px] font-black uppercase tracking-widest whitespace-nowrap">01. Hero Portada</a>
            <a href="#ethos" class="pb-6 border-b-2 border-transparent text-[#041627]/30 hover:text-[#041627] text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">02. Filosofía Ethos</a>
            <a href="#stats" class="pb-6 border-b-2 border-transparent text-[#041627]/30 hover:text-[#041627] text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">03. Métricas</a>
        </div>

        <!-- SECTION 01: HERO PORTADA -->
        <section id="hero" class="mb-32 animate-fade-in px-4 lg:px-0">
            <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-[#041627]/30 mb-10 flex items-center gap-4">
                <span class="w-8 h-px bg-[#041627]/20"></span>
                Configuración del Hero Principal
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div class="space-y-8 bg-white p-12 rounded-[2.5rem]">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-4">
                            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Badge Superior</label>
                            <input type="text" value={homeHero.badge} class="w-full bg-[#f2f4f6] border-none rounded-[0.75rem] py-4 px-6 text-sm font-bold text-[#041627] outline-none" />
                        </div>
                        <div class="space-y-4">
                            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Título Portada</label>
                            <input type="text" value={homeHero.title} class="w-full bg-[#f2f4f6] border-none rounded-[0.75rem] py-4 px-6 text-sm font-bold text-[#041627] outline-none" />
                        </div>
                    </div>
                    <div class="space-y-4">
                        <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Cuerpo del Mensaje (Slogan)</label>
                        <textarea rows="3" class="w-full bg-[#f2f4f6] border-none rounded-[1rem] py-4 px-6 text-sm font-medium text-[#44474c] leading-relaxed outline-none">{homeHero.subtitle}</textarea>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4 border-t border-slate-50">
                        <div class="space-y-4">
                            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Imagen de Fondo (Default)</label>
                            <div class="flex gap-2">
                                <input type="text" value={homeHero.imageUrl} class="flex-1 bg-[#f2f4f6] border-none rounded-xl py-4 px-6 text-[10px] font-mono text-[#006d37] outline-none" />
                                <button class="w-12 h-12 rounded-xl bg-[#041627] text-white flex items-center justify-center"><span class="material-symbols-outlined text-lg">image</span></button>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Video (Opcional)</label>
                            <div class="flex gap-2">
                                <input type="text" placeholder="URL .mp4" value={homeHero.videoUrl} class="flex-1 bg-[#f2f4f6] border-none rounded-xl py-4 px-6 text-[10px] font-mono text-slate-400 outline-none" />
                                <button class="w-12 h-12 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center"><span class="material-symbols-outlined text-lg">videocam</span></button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-[#041627] rounded-[2.5rem] p-1 items-center justify-center overflow-hidden relative border-[8px] border-white shadow-2xl">
                    <div class="absolute inset-0 bg-black/40 z-10"></div>
                    <div class="relative z-20 p-12 text-center h-full flex flex-col justify-center">
                        <span class="text-[9px] font-bold text-white uppercase tracking-[0.4em] mb-4 bg-[#006d37] inline-block px-4 py-1.5 rounded-full">{homeHero.badge}</span>
                        <h4 class="text-4xl font-heading font-black text-white italic leading-tight mb-4">{homeHero.title}</h4>
                        <p class="text-[10px] text-white/60 font-medium max-w-xs mx-auto uppercase tracking-[0.2em] leading-loose">Previsualización del Hero</p>
                    </div>
                    <div class="absolute inset-0 bg-[#041627] flex items-center justify-center">
                         <img src="https://images.unsplash.com/photo-1541888946425-d81bb19480c5?auto=format&fit=crop&w=1200&q=80" class="w-full h-full object-cover opacity-30" />
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 02: IDENTIDAD ETHOS -->
        <section id="ethos" class="mb-32 px-4 lg:px-0">
            <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-[#041627]/30 mb-10 flex items-center gap-4">
                <span class="w-8 h-px bg-[#041627]/20"></span>
                Manifiesto Editorial (Filosofía Corporativa)
            </h3>

            <!-- Preview Card -->
            <div class="bg-[#f2f4f6] rounded-[2.5rem] p-16 mb-16 relative overflow-hidden group border border-transparent hover:border-[#041627]/5 transition-all">
                <div class="relative z-10 grid grid-cols-12 gap-12 items-center">
                    <div class="col-span-12 lg:col-span-7">
                        <span class="text-[11px] font-black text-[#006d37] uppercase tracking-[0.4em] mb-6 block">Nuestra Ética</span>
                        <h2 class="text-5xl font-heading font-black text-[#041627] leading-[0.9] tracking-tighter mb-8 italic italic-bold">
                            {ethosBlocks[0].title}
                        </h2>
                        <p class="text-lg text-[#44474c] font-medium leading-relaxed max-w-lg">
                            {ethosBlocks[0].content}
                        </p>
                    </div>
                    <div class="hidden lg:block col-span-5">
                         <div class="aspect-[4/5] bg-white rounded-[2rem] shadow-[0_40px_100px_rgba(4,22,39,0.06)] overflow-hidden relative translate-x-12 group-hover:translate-x-8 transition-transform duration-1000">
                            <img src="https://images.unsplash.com/photo-1579309401309-42c161972848?auto=format&fit=crop&w=800&q=80" class="w-full h-full object-cover grayscale brightness-110" />
                         </div>
                    </div>
                </div>
            </div>

            <!-- Block Editor -->
            <div class="space-y-10">
                {ethosBlocks.map((block, i) => (
                    <div class="bg-white p-12 rounded-[2rem] group hover:shadow-[0_40px_100px_rgba(4,22,39,0.08)] transition-all duration-700">
                        <div class="flex flex-col lg:flex-row gap-16">
                            <span class="text-6xl font-heading font-black text-[#f2f4f6] leading-none select-none shrink-0 group-hover:text-[#041627]/5 transition-colors">0{i + 1}</span>
                            <div class="flex-1 space-y-10">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                                    <div class="space-y-4">
                                        <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Frase Destacada</label>
                                        <input type="text" value={block.title} class="w-full bg-[#f2f4f6] border-none rounded-[0.75rem] py-4 px-6 text-2xl font-heading font-black text-[#041627] italic outline-none" />
                                    </div>
                                    <div class="space-y-4">
                                        <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Icono Visual</label>
                                        <div class="flex gap-3">
                                            <div class="w-14 h-14 bg-[#f2f4f6] rounded-xl flex items-center justify-center text-[#041627]">
                                                <span class="material-symbols-outlined text-2xl">{block.icon}</span>
                                            </div>
                                            <input type="text" value={block.icon} class="flex-1 bg-[#f2f4f6] border-none rounded-xl py-4 px-6 text-xs font-bold text-[#041627] outline-none" />
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-4">
                                    <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-[#041627]/40 ml-1">Cuerpo Narrativo</label>
                                    <textarea rows="4" class="w-full bg-[#f2f4f6] border-none rounded-[1rem] py-6 px-8 text-[15px] font-medium text-[#44474c] leading-relaxed outline-none focus:ring-1 focus:ring-[#041627] transition-all">{block.content}</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- SECTION 03: IMPACT STATS -->
        <section id="stats" class="px-4 lg:px-0">
            <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-[#041627]/30 mb-10 flex items-center gap-4">
                <span class="w-8 h-px bg-[#041627]/20"></span>
                Diferenciadores en Números (Impacto)
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {impactStats.map(stat => (
                    <div class="bg-white p-10 rounded-[2.5rem] group hover:shadow-[0_40px_100px_rgba(4,22,39,0.06)] transition-all duration-500">
                        <div class="flex items-center gap-4 mb-10">
                            <div class="w-14 h-14 rounded-2xl bg-[#f2f4f6] flex items-center justify-center text-[#041627] group-hover:bg-[#006d37] group-hover:text-white transition-all duration-500">
                                <span class="material-symbols-outlined text-2xl">{stat.icon}</span>
                            </div>
                            <span class="text-[9px] font-black text-[#041627]/20 uppercase tracking-[0.3em]">Stats Panel</span>
                        </div>
                        <div class="space-y-8">
                            <div class="space-y-3">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-[#041627]/30 ml-1">Métrica</label>
                                <input type="text" value={stat.value} class="w-full bg-[#f2f4f6] border-none rounded-2xl py-5 px-6 text-5xl font-heading font-black text-[#041627] outline-none" />
                            </div>
                            <div class="space-y-3">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-[#041627]/30 ml-1">Label</label>
                                <input type="text" value={stat.label} class="w-full bg-[#f2f4f6] border-none rounded-xl py-4 px-6 text-[10px] font-bold text-[#041627] uppercase tracking-[0.3em] outline-none" />
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

    </div>
</AdminLayout>
