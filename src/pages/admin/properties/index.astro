---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// FETCH ALL DATA
let properties = [];
let error = null;
try {
    const response = await fetch('https://orcic.mx/api-properties.php');
    if (!response.ok) throw new Error('Error al conectar con la API');
    properties = await response.json();
    if ('error' in properties) {
        error = properties.error;
        properties = [];
    }
} catch (e) {
    error = e.message;
    properties = [];
}

const locations = [...new Set(properties.map(p => p.city))].filter(Boolean).sort();
const categories = [...new Set(properties.map(p => p.category))].filter(Boolean).sort();
---

<AdminLayout title="Inventory">
    <!-- Header Actions -->
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-8 px-2">
        <div class="max-w-xl w-full">
            <p class="text-orcic-blue font-black tracking-[0.4em] text-[10px] uppercase mb-4 block">Global Portfolio</p>
            <div class="relative w-full">
                <span class="material-symbols-outlined absolute left-6 top-1/2 -translate-y-1/2 text-on-surface-variant opacity-40">search</span>
                <input 
                    type="text" 
                    placeholder="Search by code, title or zone..." 
                    class="w-full bg-at-surface-low border-none rounded-2xl py-5 pl-14 pr-8 text-sm font-semibold focus:ring-2 focus:ring-orcic-blue/20 transition-all"
                />
            </div>
        </div>
        <div class="flex gap-4">
             <div class="bg-at-surface-low p-1.5 rounded-2xl flex">
                <button class="px-6 py-2.5 bg-at-surface-lowest text-on-surface rounded-xl text-[10px] uppercase font-black tracking-widest shadow-sm">All</button>
                <button class="px-6 py-2.5 text-on-surface-variant hover:text-on-surface rounded-xl text-[10px] uppercase font-black tracking-widest transition-colors">Active</button>
                <button class="px-6 py-2.5 text-on-surface-variant hover:text-on-surface rounded-xl text-[10px] uppercase font-black tracking-widest transition-colors">Archived</button>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="bg-at-surface-low rounded-6xl p-10 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-separate border-spacing-y-2">
                <thead>
                    <tr class="text-[10px] uppercase tracking-[0.2em] font-black text-on-surface-variant opacity-50">
                        <th class="pb-6 px-4">Property Identity</th>
                        <th class="pb-6 px-4">Location</th>
                        <th class="pb-6 px-4">Category</th>
                        <th class="pb-6 px-4">Avaliability</th>
                        <th class="pb-6 px-4 text-right">Utility</th>
                    </tr>
                </thead>
                <tbody>
                    {properties.map(prop => (
                        <tr class="group">
                            <td class="py-6 px-4 bg-at-surface-lowest rounded-l-3xl">
                                <div class="flex items-center gap-5">
                                    <div class="w-16 h-16 rounded-2xl bg-at-surface-low overflow-hidden shrink-0 group-hover:scale-105 transition-transform duration-500">
                                        <img src={prop.image || '/storage/placeholder.svg'} class="w-full h-full object-cover" />
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[9px] uppercase font-black tracking-widest text-orcic-blue mb-1">{prop.code || 'S/C'}</span>
                                        <span class="font-bold text-on-surface text-base max-w-[280px] truncate leading-tight">{prop.title || prop.name}</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-6 px-4 bg-at-surface-lowest">
                                <div class="flex items-center gap-2 text-on-surface-variant font-medium text-sm">
                                    <span class="material-symbols-outlined text-lg opacity-30">location_on</span>
                                    {prop.city}
                                </div>
                            </td>
                            <td class="py-6 px-4 bg-at-surface-lowest">
                                <span class="px-4 py-1.5 bg-at-surface-low text-on-surface rounded-full text-[9px] font-black uppercase tracking-widest">{prop.category}</span>
                            </td>
                            <td class="py-6 px-4 bg-at-surface-lowest">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full bg-at-secondary shadow-[0_0_10px_rgba(0,109,55,0.4)]"></div>
                                    <span class="text-[10px] font-black uppercase tracking-tighter text-on-surface">For Sale</span>
                                </div>
                            </td>
                            <td class="py-6 px-4 bg-at-surface-lowest rounded-r-3xl text-right">
                                <div class="flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0">
                                    <a href={`/admin/properties/edit/${prop.id}`} class="w-11 h-11 rounded-xl bg-at-surface-low flex items-center justify-center text-on-surface-variant hover:text-orcic-blue hover:shadow-xl transition-all">
                                        <span class="material-symbols-outlined text-xl">edit</span>
                                    </a>
                                    <button class="w-11 h-11 rounded-xl bg-at-surface-low flex items-center justify-center text-on-surface-variant hover:text-red-500 hover:shadow-xl transition-all">
                                        <span class="material-symbols-outlined text-xl">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
        
        {properties.length === 0 && (
            <div class="py-32 text-center bg-at-surface-lowest rounded-4xl">
                <div class="w-24 h-24 bg-at-surface-low rounded-full flex items-center justify-center mx-auto mb-6 text-on-surface-variant/20">
                    <span class="material-symbols-outlined text-5xl font-black">inventory_2</span>
                </div>
                <h3 class="text-xl font-heading font-black text-on-surface">No architectural data found</h3>
                <p class="text-on-surface-variant text-sm mt-3 max-w-xs mx-auto opacity-60">{error || 'Your inventory is currently empty.'}</p>
            </div>
        )}
    </div>
</AdminLayout>

