---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Mock data for featured developments in bento
const featuredDevelopments = [
    { id: 1, name: "Mérida Heritage", properties: 42, size: "Large (8x2)", image: "https://orcic.mx/storage/merida.jpg" },
    { id: 2, name: "Cancún Industrial", properties: 15, size: "Tall (4x4)", image: "https://orcic.mx/storage/cancun.jpg" },
    { id: 3, name: "Tulum Eco-Space", properties: 8, size: "Square (4x2)", image: "https://orcic.mx/storage/tulum.jpg" },
    { id: 4, name: "Valladolid Colonial", properties: 12, size: "Square (4x2)", image: "https://orcic.mx/storage/valladolid.jpg" }
];
---

<AdminLayout title="Bento Grid Manager">
    <div class="max-w-6xl">
        <div class="flex items-center justify-between mb-12">
            <div>
                <p class="text-orcic-blue font-black tracking-[0.4em] text-[10px] uppercase mb-2">Home Page Layout</p>
                <h2 class="text-3xl font-heading font-black text-on-surface tracking-tight italic">Featured Developments Bento</h2>
            </div>
            <div class="flex gap-4">
                <button class="bg-at-surface-low text-on-surface-variant px-6 py-4 rounded-xl font-bold text-[11px] uppercase tracking-widest hover:bg-at-surface-lowest transition-all">
                    Reset Grid
                </button>
                <button class="bg-at-secondary text-white px-8 py-4 rounded-xl font-bold text-[11px] uppercase tracking-widest hover:opacity-90 transition-all shadow-xl shadow-at-secondary/10">
                    Save Layout
                </button>
            </div>
        </div>

        <!-- Bento Visualizer (MOCK) -->
        <div class="bg-at-surface-low rounded-[3rem] p-12 mb-12">
            <h3 class="text-xs font-black uppercase tracking-widest text-on-surface-variant mb-8 opacity-40">Grid Visualizer</h3>
            
            <div class="grid grid-cols-12 gap-4 h-[400px]">
                <div class="col-span-8 bg-at-surface-lowest rounded-3xl border-2 border-dashed border-at-outline/20 flex flex-col items-center justify-center relative overflow-hidden group cursor-pointer hover:border-orcic-blue transition-all">
                    <img src={featuredDevelopments[0].image} class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale brightness-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
                    <div class="relative z-10 text-center">
                        <span class="text-[9px] font-black uppercase tracking-widest px-3 py-1 bg-orcic-blue text-white rounded-full mb-3 inline-block">Slot 1 (8x2)</span>
                        <p class="font-black text-xl text-on-surface group-hover:text-white transition-colors">{featuredDevelopments[0].name}</p>
                    </div>
                </div>
                <div class="col-span-4 row-span-2 bg-at-surface-lowest rounded-3xl border-2 border-dashed border-at-outline/20 flex flex-col items-center justify-center relative overflow-hidden group cursor-pointer hover:border-orcic-blue transition-all">
                    <img src={featuredDevelopments[1].image} class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale brightness-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
                    <div class="relative z-10 text-center">
                        <span class="text-[9px] font-black uppercase tracking-widest px-3 py-1 bg-orcic-blue text-white rounded-full mb-3 inline-block">Slot 2 (4x4)</span>
                        <p class="font-black text-xl text-on-surface group-hover:text-white transition-colors">{featuredDevelopments[1].name}</p>
                    </div>
                </div>
                <div class="col-span-4 bg-at-surface-lowest rounded-3xl border-2 border-dashed border-at-outline/20 flex flex-col items-center justify-center relative overflow-hidden group cursor-pointer hover:border-orcic-blue transition-all">
                    <img src={featuredDevelopments[2].image} class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale brightness-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
                    <div class="relative z-10 text-center">
                        <span class="text-[9px] font-black uppercase tracking-widest px-3 py-1 bg-orcic-blue text-white rounded-full mb-3 inline-block">Slot 3 (4x2)</span>
                        <p class="font-black text-xl text-on-surface group-hover:text-white transition-colors">{featuredDevelopments[2].name}</p>
                    </div>
                </div>
                <div class="col-span-4 bg-at-surface-lowest rounded-3xl border-2 border-dashed border-at-outline/20 flex flex-col items-center justify-center relative overflow-hidden group cursor-pointer hover:border-orcic-blue transition-all">
                    <img src={featuredDevelopments[3].image} class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale brightness-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
                    <div class="relative z-10 text-center">
                        <span class="text-[9px] font-black uppercase tracking-widest px-3 py-1 bg-orcic-blue text-white rounded-full mb-3 inline-block">Slot 4 (4x2)</span>
                        <p class="font-black text-xl text-on-surface group-hover:text-white transition-colors">{featuredDevelopments[3].name}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management List -->
        <div class="space-y-4">
            {featuredDevelopments.map((dev, i) => (
                <div class="bg-at-surface-lowest p-6 rounded-3xl flex items-center gap-6 shadow-sm border border-at-outline/5 group hover:shadow-xl transition-all">
                    <div class="w-10 h-10 rounded-full bg-at-surface-low flex items-center justify-center font-black text-xs text-on-surface-variant shrink-0">#{i + 1}</div>
                    
                    <div class="flex-1 grid grid-cols-3 gap-6">
                        <div>
                            <label class="block text-[9px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Development Name</label>
                            <input 
                                type="text" 
                                value={dev.name}
                                class="w-full bg-at-surface-low border-none rounded-xl py-3 px-4 text-sm font-bold text-on-surface outline-none focus:ring-2 focus:ring-orcic-blue/20"
                            />
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Grid Dimension</label>
                            <select class="w-full bg-at-surface-low border-none rounded-xl py-3 px-4 text-sm font-bold text-on-surface outline-none focus:ring-2 focus:ring-orcic-blue/20">
                                <option selected={dev.size.includes('Large')}>Large (8x2)</option>
                                <option selected={dev.size.includes('Tall')}>Tall (4x4)</option>
                                <option selected={dev.size.includes('Square')}>Square (4x2)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Cover Hash/URL</label>
                            <div class="flex gap-2">
                                <input 
                                    type="text" 
                                    value="merida_heritage_aerial.jpg"
                                    class="flex-1 bg-at-surface-low border-none rounded-xl py-3 px-4 text-[10px] font-mono text-orcic-blue outline-none"
                                />
                                <button class="w-11 h-11 rounded-xl bg-orcic-blue/5 text-orcic-blue flex items-center justify-center hover:bg-orcic-blue hover:text-white transition-all">
                                    <span class="material-symbols-outlined text-lg">image</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button class="w-10 h-10 rounded-xl bg-at-surface-low text-on-surface-variant hover:text-on-surface transition-colors">
                            <span class="material-symbols-outlined text-xl">swap_vert</span>
                        </button>
                        <button class="w-10 h-10 rounded-xl bg-at-surface-low text-on-surface-variant hover:text-red-500 transition-colors">
                            <span class="material-symbols-outlined text-xl">delete</span>
                        </button>
                    </div>
                </div>
            ))}

            <button class="w-full py-6 mt-4 border-2 border-dashed border-at-outline/20 rounded-3xl text-sm font-black uppercase tracking-widest text-on-surface-variant hover:border-orcic-blue hover:text-orcic-blue transition-all">
                + Add Development to featured grid
            </button>
        </div>
    </div>
</AdminLayout>
