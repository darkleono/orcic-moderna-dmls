---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import About from '../components/About.astro';
import Developments from '../components/Developments.astro';
import type { Property } from '../components/PropertyCard.astro';

// CENTRALIZANDO API CLIENT (Secure Bridge)
import { fetchProperties } from '../lib/api';

let properties: Property[] = [];
let locations: string[] = [];
let types: string[] = [];

try {
    properties = await fetchProperties();
    
    if (properties.length > 0) {
        // Extraemos ubicaciones y tipos ÚNICOS de la data real
        locations = [...new Set(properties.map(p => p.city))].filter(Boolean).sort();
        types = [...new Set(properties.map(p => p.category))].filter(Boolean).sort();
    }
} catch (e) {
    console.error('Fetch error:', e);
    properties = [];
}

// IMPORT DATA DESDE EL CEREBRO CENTRAL
import homeData from '/src/data/homeData.json';
---

<Layout title="ORCIC | Inversión y Legado Inmobiliario">
	<!-- Top Navigation Bar -->
    <header class="fixed top-0 w-full z-50 bg-white/70 backdrop-blur-xl border-b border-at-outline/20 duration-300">
        <div class="flex items-center justify-between px-8 h-20 max-w-7xl mx-auto">
            <div class="flex items-center gap-16">
                <a class="flex items-center group" href="/">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-12 w-auto object-contain transition-transform duration-500 group-hover:scale-105" fetchpriority="high" loading="eager" />
                </a>
                <nav class="hidden lg:flex items-center space-x-12">
                    <a class="text-orcic-navy-deep font-bold border-b-2 border-orcic-navy font-heading text-xs uppercase tracking-[0.2em] transition-all" href="#catalog">Propiedades</a>
                    <a class="text-on-surface-variant font-bold font-heading text-xs uppercase tracking-[0.2em] hover:text-orcic-navy-deep transition-all" href="#desarrollos">Desarrollos</a>
                    <a class="text-on-surface-variant font-bold font-heading text-xs uppercase tracking-[0.2em] hover:text-orcic-navy-deep transition-all" href="#nosotros">Nosotros</a>
                    <a class="text-on-surface-variant font-bold font-heading text-xs uppercase tracking-[0.2em] hover:text-orcic-navy-deep transition-all" href="#">Contacto</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <button class="bg-orcic-navy-deep text-white px-8 py-3 rounded-lg font-bold hover:bg-orcic-navy shadow-at-ambient transition-all active:scale-95 text-xs uppercase tracking-[0.2em] font-heading">
                    Contactar Ahora
                </button>
            </div>
        </div>
    </header>

	<main>
		<!-- Hero Section -->
		<section class="relative min-h-[100vh] flex items-center pt-20 overflow-hidden bg-orcic-navy-deep">
			<div class="absolute inset-0 z-0">
				<img 
                    class="w-full h-full object-cover origin-center" 
                    src={homeData.hero.imageUrl} 
                    alt="Mediterráneo Residencial - ORCIC"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                />
				<div class="absolute inset-0 bg-gradient-to-r from-orcic-navy-deep/90 via-orcic-navy-deep/40 to-transparent"></div>
			</div>
			<div class="relative z-10 w-full max-w-7xl mx-auto px-8 py-20 flex flex-col items-start gap-20">
				<!-- Bloque de Texto (Marca a la Izquierda) -->
                <div class="max-w-4xl text-left text-white">
                    <span class="inline-block px-5 py-2 bg-white/5 backdrop-blur-lg rounded-full text-white text-[10px] font-black uppercase tracking-[0.4em] mb-12 border border-white/10 shadow-at-ambient leading-none">
                        {homeData.hero.badge}
                    </span>
					<h1 class="text-6xl md:text-8xl font-heading font-black leading-[1.05] tracking-tighter mb-10 drop-shadow-2xl hero-title">
						<Fragment set:html={homeData.hero.title} />
					</h1>
					<p class="text-lg md:text-xl text-white/80 max-w-2xl leading-relaxed font-medium drop-shadow-lg opacity-90">
						{homeData.hero.subtitle}
					</p>
                </div>
					
                <!-- Architectural Glass Search Bar -->
                <div class="w-full">
                    <div class="bg-white/5 backdrop-blur-2xl p-1.5 rounded-2xl border border-white/10 shadow-at-elevated w-full max-w-4xl relative z-20">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-0 items-center">
                            <div class="px-10 py-7 flex flex-col border-r border-white/10 group/item hover:bg-white/5 transition-colors cursor-pointer rounded-l-xl">
                                <label class="text-[9px] uppercase tracking-[0.3em] text-white/50 mb-3 font-black">Ubicación</label>
                                <select id="search-location" class="bg-transparent border-none p-0 text-white focus:ring-0 font-bold appearance-none cursor-pointer text-sm tracking-tight outline-none">
                                    <option class="text-slate-900" value="all">Todas las zonas</option>
                                    {locations.map(loc => (
                                        <option class="text-slate-900" value={loc}>{loc}</option>
                                    ))}
                                </select>
                            </div>
                            <div class="px-10 py-7 flex flex-col border-r border-white/10 group/item hover:bg-white/5 transition-colors cursor-pointer">
                                <label class="text-[9px] uppercase tracking-[0.3em] text-white/50 mb-3 font-black">Tipo de Propiedad</label>
                                <select id="search-type" class="bg-transparent border-none p-0 text-white focus:ring-0 font-bold appearance-none cursor-pointer text-sm tracking-tight outline-none">
                                    <option class="text-slate-900" value="all">Cualquier tipo</option>
                                    {types.map(t => (
                                        <option class="text-slate-900" value={t}>{t}</option>
                                    ))}
                                </select>
                            </div>
                            <div class="px-10 py-7 flex flex-col border-r border-white/10 group/item hover:bg-white/5 transition-colors cursor-pointer">
                                <label class="text-[9px] uppercase tracking-[0.3em] text-white/50 mb-3 font-black">Presupuesto</label>
                                <select id="search-price" class="bg-transparent border-none p-0 text-white focus:ring-0 font-bold appearance-none cursor-pointer text-sm tracking-tight outline-none">
                                    <option class="text-slate-900" value="all">Cualquier precio</option>
                                    <option class="text-slate-900" value="1-5M">$1M - $5M MXN</option>
                                    <option class="text-slate-900" value="5-10M">$5M - $10M MXN</option>
                                    <option class="text-slate-900" value="10M+">$10M+ MXN</option>
                                </select>
                            </div>
                            <div class="px-6 py-6 flex items-center justify-center">
                                <button id="search-btn" class="w-full bg-white text-orcic-navy-deep h-14 rounded-xl font-black flex items-center justify-center gap-3 hover:bg-at-tertiary transition-all duration-500 group shadow-at-elevated">
                                    <span class="material-symbols-outlined text-xl group-hover:scale-110 transition-transform">search</span>
                                    <span class="uppercase tracking-[0.2em] text-[10px]">Buscar Legado</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
			</div>
		</section>

        <!-- Sección Quiénes Somos (Video) -->
        <About />

        <!-- Sección Nuestros Desarrollos (Bento Grid) -->
        <Developments />

		<!-- Featured Properties Gallery -->
		<section id="catalog" class="py-32 bg-at-surface px-8">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
					<div class="max-w-xl">
						<span class="text-orcic-navy font-black tracking-[0.4em] text-[10px] uppercase mb-6 block drop-shadow-sm">Archivos de Alta Gama</span>
						<h2 class="text-5xl md:text-7xl font-heading font-black text-on-surface leading-[1.05] tracking-tighter">Portafolio <br/> <span class="text-orcic-navy italics drop-shadow-md">Estratégico.</span></h2>
					</div>
					<a class="bg-at-surface-lowest px-10 py-5 rounded-xl text-on-surface font-black uppercase tracking-[0.2em] text-[10px] flex items-center gap-3 hover:bg-orcic-navy-deep hover:text-white transition-all shadow-at-ambient group" href="#">
						Ver Catálogo Completo <span class="material-symbols-outlined text-orcic-navy group-hover:translate-x-2 transition-transform">arrow_forward</span>
					</a>
				</div>
                
                <div id="property-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                    {properties.map((prop) => (
                        <div class="property-item" data-location={prop.city} data-type={prop.category}>
                            <PropertyCard property={prop} />
                        </div>
                    ))}
                </div>

                <!-- Buscador Vacío (Oculto por defecto) -->
                <div id="no-results" class="hidden text-center py-32 bg-slate-50 rounded-[3rem] border border-slate-100 shadow-inner mt-12">
                    <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-slate-300">search_off</span>
                    </div>
                    <p class="text-slate-900 font-black text-xl font-['Manrope']">No encontramos propiedades</p>
                    <p class="text-slate-400 text-sm mt-2 max-w-xs mx-auto">Prueba ajustando los filtros de búsqueda para encontrar tu espacio ideal.</p>
                </div>
			</div>
		</section>

        <script is:inline>
            document.getElementById('search-btn')?.addEventListener('click', () => {
                const locSelect = document.getElementById('search-location');
                const typeSelect = document.getElementById('search-type');
                const selectedLoc = locSelect.value;
                const selectedType = typeSelect.value;
                
                const items = document.querySelectorAll('.property-item');
                const noResults = document.getElementById('no-results');
                
                let found = 0;

                items.forEach(item => {
                    const itemLoc = item.dataset.location;
                    const itemType = item.dataset.type;
                    
                    const locMatch = selectedLoc === 'all' || itemLoc === selectedLoc;
                    const typeMatch = selectedType === 'all' || itemType === selectedType;

                    if (locMatch && typeMatch) {
                        item.style.display = 'block';
                        found++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (found === 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }

                // Scroll suave a los resultados
                document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
            });
        </script>
	</main>

	<!-- Footer -->
    <footer class="w-full bg-orcic-navy-deep text-white/90">
        <div class="max-w-7xl mx-auto px-8 py-32">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-x-16 gap-y-20 mb-28">
                <div class="md:col-span-5">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain mb-10 brightness-0 invert" loading="lazy" />
                    <p class="text-white/60 max-w-sm mb-12 leading-relaxed font-medium text-lg">Lideramos el mercado de bienes raíces industriales y de lujo con un enfoque en ingeniería, integridad y resultados excepcionales en todo México.</p>
                    <div class="flex gap-4">
                        <a href="#" class="w-14 h-14 rounded-xl bg-white/5 flex items-center justify-center text-white border border-white/10 hover:bg-white hover:text-orcic-navy-deep transition-all shadow-at-ambient"><span class="material-symbols-outlined">share</span></a>
                        <a href="#" class="w-14 h-14 rounded-xl bg-white/5 flex items-center justify-center text-white border border-white/10 hover:bg-white hover:text-orcic-navy-deep transition-all shadow-at-ambient"><span class="material-symbols-outlined">mail</span></a>
                    </div>
                </div>
                <div class="md:col-span-2">
                    <h5 class="font-black text-white mb-10 uppercase tracking-[0.3em] text-[10px]">Menú Principal</h5>
                    <ul class="space-y-6">
                        <li><a class="text-white/50 hover:text-white transition-colors text-xs font-black uppercase tracking-widest" href="#nosotros">Nosotros</a></li>
                        <li><a class="text-white/50 hover:text-white transition-colors text-xs font-black uppercase tracking-widest" href="#catalog">Propiedades</a></li>
                        <li><a class="text-white/50 hover:text-white transition-colors text-xs font-black uppercase tracking-widest" href="#desarrollos">Desarrollos</a></li>
                    </ul>
                </div>
                <div class="md:col-span-2">
                    <h5 class="font-black text-white mb-10 uppercase tracking-[0.3em] text-[10px]">Zonas Estratégicas</h5>
                    <ul class="space-y-6">
                        <li><span class="text-white/50 text-xs font-black uppercase tracking-widest block">Mérida, YUC.</span></li>
                        <li><span class="text-white/50 text-xs font-black uppercase tracking-widest block">Veracruz, VER.</span></li>
                    </ul>
                </div>
                <div class="md:col-span-3">
                    <h5 class="font-black text-white mb-10 uppercase tracking-[0.3em] text-[10px]">Soporte ORCIC</h5>
                    <button class="w-full bg-white text-orcic-navy-deep py-5 rounded-xl font-black uppercase tracking-[0.2em] text-xs hover:bg-at-tertiary transition-all mb-6 shadow-at-elevated">Contactar Asesor</button>
                    <p class="text-white/30 text-[9px] text-center uppercase tracking-[0.4em] font-black">Disponibilidad 24/7 de Alta Prioridad</p>
                </div>
            </div>
            <div class="pt-16 border-t border-white/5 flex flex-col md:flex-row justify-between items-center w-full gap-8">
                <p class="text-[9px] uppercase tracking-[0.4em] text-white/40 font-black text-center md:text-left">© 2024 ORCIC INMOBILIARIA. <span class="hidden md:inline mx-4">|</span> Legado e Ingeniería Inmobiliaria.</p>
                <div class="flex gap-10">
                    <a href="#" class="text-[9px] uppercase tracking-[0.4em] text-white/40 hover:text-white transition-colors font-black">Aviso de Privacidad</a>
                    <a href="#" class="text-[9px] uppercase tracking-[0.4em] text-white/40 hover:text-white transition-colors font-black">Términos</a>
                </div>
            </div>
        </div>
    </footer>
</Layout>

<style is:global>
    /* Premium Title Accent for Hero: replaces orcic-blue with orcic-navy-deep but lighter or custom gold/emerald if needed */
    .hero-title .text-orcic-blue {
        @apply text-white/90 drop-shadow-md;
        background: linear-gradient(135deg, white 0%, rgba(255,255,255,0.7) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
