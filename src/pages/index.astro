---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import type { Property } from '../components/PropertyCard.astro';

// FETCH EN VIVO: Astro pedirá estos datos a tu servidor cada vez que se construya el sitio
let properties: Property[] = [];
try {
    const response = await fetch('https://orcic.mx/api-properties.php');
    if (!response.ok) throw new Error('Error al obtener propiedades');
    properties = await response.json();
    
    // Si la API devuelve un error estructurado
    if ('error' in properties) {
        console.error('API Error:', properties.error);
        properties = [];
    }
} catch (e) {
    console.error('Fetch error:', e);
    properties = [];
}
---

<Layout title="ORCIC | Inversión y Legado Inmobiliario">
	<!-- Top Navigation Bar -->
    <header class="fixed top-0 w-full z-50 bg-white shadow-sm border-b border-slate-100 duration-300">
        <div class="flex items-center justify-between px-8 h-22 max-w-7xl mx-auto py-4">
            <div class="flex items-center gap-12">
                <a class="flex items-center gap-3 group" href="/">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain group-hover:scale-105 transition-transform" />
                </a>
                <nav class="hidden lg:flex items-center space-x-8">
                    <a class="text-orcic-blue font-bold border-b-2 border-orcic-blue font-['Manrope'] tracking-tight transition-colors" href="#">Comprar</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Rentar</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Journal</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Nosotros</a>
                </nav>
            </div>
            <div class="flex items-center space-x-6">
                <button class="text-[#0b213b] font-black px-4 py-2 hover:text-[#007bff] transition-colors text-sm uppercase tracking-widest">Ingresar</button>
                <button class="bg-[#0b213b] text-white px-10 py-4 rounded-xl font-black hover:bg-[#007bff] shadow-xl shadow-[#0b213b]/20 transition-all active:scale-95 text-xs uppercase tracking-[0.15em]">Contactar Ahora</button>
            </div>
        </div>
    </header>

	<main>
		<!-- Hero Section -->
		<section class="relative min-h-[100vh] flex items-center pt-24 overflow-hidden bg-[#0b213b]">
			<div class="absolute inset-0 z-0">
				<img 
                    class="w-full h-full object-cover" 
                    src="/home_mediterraneo_izq.png" 
                    alt="Mediterráneo Residencial - ORCIC"
                />
				<div class="absolute inset-0 bg-gradient-to-r from-[#0b213b]/85 via-[#0b213b]/40 to-transparent"></div>
			</div>
			<div class="relative z-10 w-full max-w-7xl mx-auto px-8 py-24">
				<div class="max-w-3xl text-white">
                    <span class="inline-block px-4 py-1.5 bg-[#007bff]/20 backdrop-blur-md rounded-full text-white text-xs font-bold uppercase tracking-[0.2em] mb-8 border border-white/20 shadow-sm leading-none">Líderes en Consorcio Industrial</span>
					<h1 class="text-6xl md:text-8xl font-['Manrope'] font-black leading-[1.05] tracking-tighter mb-8 drop-shadow-2xl">
						Tu Legado, <br/> <span class="text-[#007bff]">Nuestra Ingeniería.</span>
					</h1>
					<p class="text-xl text-white mb-12 max-w-xl leading-relaxed font-semibold drop-shadow-lg">
						Desde naves industriales hasta residencias exclusivas. En <strong>ORCIC</strong> construimos más que espacios, definimos el futuro inmobiliario en México.
					</p>
					
					<!-- Advanced Search Bar -->
					<div class="bg-white/10 backdrop-blur-2xl p-2 rounded-2xl shadow-2xl border border-white/20 max-w-4xl">
						<div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center">
							<div class="px-6 py-4 flex flex-col border-r border-white/10">
								<label class="text-[10px] uppercase tracking-widest text-white/60 mb-1 font-bold">Ubicación</label>
								<input class="bg-transparent border-none p-0 text-white placeholder:text-white/40 focus:ring-0 font-medium" placeholder="Donde buscas..." type="text"/>
							</div>
							<div class="px-6 py-4 flex flex-col border-r border-white/10">
								<label class="text-[10px] uppercase tracking-widest text-white/60 mb-1 font-bold">Tipo</label>
								<select class="bg-transparent border-none p-0 text-white focus:ring-0 font-medium appearance-none cursor-pointer">
									<option class="text-slate-900">Casa Residencial</option>
									<option class="text-slate-900">Nave Industrial</option>
									<option class="text-slate-900">Terrenos</option>
								</select>
							</div>
							<div class="px-6 py-4 flex flex-col border-r border-white/10">
								<label class="text-[10px] uppercase tracking-widest text-white/60 mb-1 font-bold">Presupuesto</label>
								<input class="bg-transparent border-none p-0 text-white placeholder:text-white/40 focus:ring-0 font-medium" placeholder="Ver precios" type="text"/>
							</div>
							<div class="p-1">
								<button class="w-full bg-orcic-blue text-white h-14 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-white hover:text-orcic-navy transition-all shadow-lg shadow-orcic-blue/40">
									<span class="material-symbols-outlined">search</span>
									Buscar
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Properties -->
		<section class="py-24 bg-slate-50 px-8">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-8">
					<div class="max-w-xl">
						<span class="text-orcic-blue font-bold tracking-widest text-xs uppercase mb-3 block">Bienes Raíces de Alta Gama</span>
						<h2 class="text-4xl md:text-5xl font-['Manrope'] font-bold text-slate-900 leading-tight">Portafolio Industrial <br/> y Residencial</h2>
					</div>
					<a class="bg-white px-6 py-3 rounded-xl border border-slate-200 text-slate-900 font-bold flex items-center gap-2 hover:bg-slate-50 transition-all shadow-sm" href="#">
						Ver Todas <span class="material-symbols-outlined text-orcic-blue">arrow_forward</span>
					</a>
				</div>
                
                {properties.length === 0 ? (
                    <div class="text-center py-32 bg-white rounded-3xl border-2 border-dashed border-slate-200 shadow-inner">
                        <span class="material-symbols-outlined text-6xl text-slate-200 mb-4">analytics</span>
                        <p class="text-slate-500 font-medium text-lg">No hay propiedades disponibles ahora mismo.</p>
                        <p class="text-slate-400 text-sm mt-2">Nuestras naves industriales suelen volar rápido.</p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {properties.map((prop) => (
                            <PropertyCard property={prop} />
                        ))}
                    </div>
                )}
			</div>
		</section>

	</main>

	<!-- Footer -->
    <footer class="w-full border-t border-slate-100 bg-white">
        <div class="max-w-7xl mx-auto px-8 py-20">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-16 mb-16">
                <div class="md:col-span-4">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain mb-8" />
                    <p class="text-slate-500 max-w-sm mb-8 leading-relaxed font-medium">Lideramos el mercado de bienes raíces industriales y de lujo con un enfoque en ingeniería, integridad y resultados excepcionales.</p>
                    <div class="flex gap-4">
                        <a href="#" class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-900 hover:bg-orcic-navy hover:text-white transition-all"><span class="material-symbols-outlined text-sm">share</span></a>
                        <a href="#" class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-900 hover:bg-orcic-navy hover:text-white transition-all"><span class="material-symbols-outlined text-sm">mail</span></a>
                    </div>
                </div>
                <div class="md:col-span-2">
                    <h5 class="font-bold text-slate-900 mb-8 uppercase tracking-widest text-[10px]">Empresa</h5>
                    <ul class="space-y-4">
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-semibold" href="#">Nosotros</a></li>
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-semibold" href="#">Portafolio</a></li>
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-semibold" href="#">Contacto</a></li>
                    </ul>
                </div>
                <div class="md:col-span-3">
                    <h5 class="font-bold text-slate-900 mb-8 uppercase tracking-widest text-[10px]">Ubicaciones</h5>
                    <ul class="space-y-4">
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-semibold flex items-center gap-2" href="#">
                            <span class="material-symbols-outlined text-xs">location_on</span> Mérida, Yucatán
                        </a></li>
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-semibold flex items-center gap-2" href="#">
                            <span class="material-symbols-outlined text-xs">location_on</span> Veracruz, México
                        </a></li>
                    </ul>
                </div>
                <div class="md:col-span-3">
                    <h5 class="font-bold text-slate-900 mb-8 uppercase tracking-widest text-[10px]">Soporte</h5>
                    <button class="w-full bg-slate-900 text-white py-3 rounded-xl font-bold hover:bg-orcic-blue transition-all mb-4">Llamar Ahora</button>
                    <p class="text-slate-400 text-[10px] text-center uppercase tracking-widest">Lunes a Viernes • 9am a 6pm</p>
                </div>
            </div>
            <div class="pt-12 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center w-full gap-4">
                <p class="text-xs uppercase tracking-widest text-slate-400 font-bold">© 2024 ORCIC INMOBILIARIA. Legado e Ingeniería.</p>
                <div class="flex gap-8">
                    <a href="#" class="text-xs uppercase tracking-widest text-slate-400 hover:text-slate-900 transition-colors">Aviso de Privacidad</a>
                    <a href="#" class="text-xs uppercase tracking-widest text-slate-400 hover:text-slate-900 transition-colors">Terminos</a>
                </div>
            </div>
        </div>
    </footer>
</Layout>
</Layout>
