---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import type { Property } from '../components/PropertyCard.astro';

// FETCH EN VIVO: Astro pedirá estos datos a tu servidor cada vez que se construya el sitio
let properties: Property[] = [];
try {
    const response = await fetch('https://orcic.mx/api-properties.php');
    if (!response.ok) throw new Error('Error al obtener propiedades');
    properties = await response.json();
    
    // Si la API devuelve un error estructurado
    if ('error' in properties) {
        console.error('API Error:', properties.error);
        properties = [];
    }
} catch (e) {
    console.error('Fetch error:', e);
    properties = [];
}
---

<Layout title="ORCIC | Inversión y Legado Inmobiliario">
	<!-- Top Navigation Bar -->
    <header class="fixed top-0 w-full z-50 bg-white shadow-sm border-b border-slate-100 duration-300">
        <div class="flex items-center justify-between px-8 h-22 max-w-7xl mx-auto py-4">
            <div class="flex items-center gap-12">
                <a class="flex items-center gap-3 group" href="/">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain group-hover:scale-105 transition-transform" />
                </a>
                <nav class="hidden lg:flex items-center space-x-8">
                    <a class="text-orcic-blue font-bold border-b-2 border-orcic-blue font-['Manrope'] tracking-tight transition-colors" href="#">Comprar</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Rentar</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Journal</a>
                    <a class="text-slate-700 font-semibold font-['Manrope'] tracking-tight hover:text-orcic-blue transition-colors" href="#">Nosotros</a>
                </nav>
            </div>
            <div class="flex items-center space-x-4">
                <button class="text-orcic-navy font-black px-4 py-2 hover:text-orcic-blue transition-colors text-sm uppercase tracking-wider">Ingresar</button>
                <button class="bg-orcic-navy text-white px-8 py-3.5 rounded-xl font-bold hover:bg-orcic-blue shadow-lg shadow-orcic-navy/30 transition-all active:scale-95 text-sm uppercase tracking-widest">Contactar Ahora</button>
            </div>
        </div>
    </header>

	<main>
		<!-- Hero Section -->
		<section class="relative min-h-[100vh] flex items-center pt-24 overflow-hidden bg-orcic-navy">
			<div class="absolute inset-0 z-0">
				<img 
                    class="w-full h-full object-cover scale-100" 
                    src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" 
                    alt="Industrial and Luxury Real Estate"
                />
				<div class="absolute inset-0 bg-gradient-to-r from-orcic-navy/80 via-orcic-navy/40 to-transparent"></div>
			</div>
			<div class="relative z-10 w-full max-w-7xl mx-auto px-8 py-24">
				<div class="max-w-3xl text-white">
                    <span class="inline-block px-4 py-1.5 bg-orcic-blue/20 backdrop-blur-md rounded-full text-orcic-blue text-xs font-bold uppercase tracking-[0.2em] mb-8 border border-orcic-blue/30 shadow-sm">Líderes en Consorcio Industrial</span>
					<h1 class="text-6xl md:text-8xl font-['Manrope'] font-extrabold leading-[1.05] tracking-tighter mb-8 drop-shadow-2xl">
						Tu Legado, <br/> <span class="text-orcic-blue">Nuestra Ingeniería.</span>
					</h1>
					<p class="text-xl text-slate-100 mb-12 max-w-xl leading-relaxed font-medium drop-shadow-lg">
						Desde naves industriales hasta residencias exclusivas. En <strong>ORCIC</strong> construimos más que espacios, definimos el futuro inmobiliario en México.
					</p>
					
					<!-- Advanced Search Bar -->
					<div class="bg-white p-2 rounded-2xl shadow-2xl shadow-black/40 max-w-4xl">
						<div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center">
							<div class="px-6 py-4 flex flex-col border-r border-slate-100">
								<label class="text-[10px] uppercase tracking-widest text-slate-400 mb-1 font-bold">Ubicación</label>
								<input class="bg-transparent border-none p-0 text-slate-900 placeholder:text-slate-300 focus:ring-0 font-medium" placeholder="Mérida, Veracruz..." type="text"/>
							</div>
							<div class="px-6 py-4 flex flex-col border-r border-slate-100">
								<label class="text-[10px] uppercase tracking-widest text-slate-400 mb-1 font-bold">Tipo</label>
								<select class="bg-transparent border-none p-0 text-slate-900 focus:ring-0 font-medium appearance-none">
									<option class="text-slate-900">Casa Residencial</option>
									<option class="text-slate-900">Nave Industrial</option>
									<option class="text-slate-900">Terrenos</option>
								</select>
							</div>
							<div class="px-6 py-4 flex flex-col border-r border-slate-100">
								<label class="text-[10px] uppercase tracking-widest text-slate-400 mb-1 font-bold">Presupuesto</label>
								<input class="bg-transparent border-none p-0 text-slate-900 placeholder:text-slate-300 focus:ring-0 font-medium" placeholder="Ver precios" type="text"/>
							</div>
							<div class="p-1">
								<button class="w-full bg-orcic-blue text-white h-14 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-orcic-navy transition-all shadow-lg shadow-orcic-blue/20">
									<span class="material-symbols-outlined">search</span>
									Buscar
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Properties -->
		<section class="py-24 bg-slate-50 px-8">
			<div class="max-w-7xl mx-auto">
				<div class="flex justify-between items-end mb-12">
					<div>
						<span class="text-emerald-600 font-bold tracking-widest text-xs uppercase mb-2 block">Colección Curada</span>
						<h2 class="text-4xl font-['Manrope'] font-bold text-slate-900">Propiedades Destacadas</h2>
					</div>
					<a class="text-slate-900 font-semibold flex items-center gap-2 hover:gap-3 transition-all" href="#">
						Ver Todas <span class="material-symbols-outlined">arrow_forward</span>
					</a>
				</div>
                
                {properties.length === 0 ? (
                    <div class="text-center py-20 bg-white rounded-2xl border-2 border-dashed border-slate-200">
                        <p class="text-slate-500">No hay propiedades disponibles ahora mismo.</p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                        {properties.map((prop) => (
                            <PropertyCard property={prop} />
                        ))}
                    </div>
                )}
			</div>
		</section>

	</main>

	<!-- Footer -->
    <footer class="w-full border-t border-slate-200 bg-white">
        <div class="max-w-7xl mx-auto px-12 py-16">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <div class="col-span-1 md:col-span-2">
                    <a class="text-2xl font-black text-slate-900 mb-6 block font-['Manrope']" href="#">EstateArchitect</a>
                    <p class="text-slate-500 max-w-sm mb-6">Definiendo el estándar para vivir con lujo. Global Real Estate & Investment Advisory.</p>
                </div>
                <div>
                    <h5 class="font-bold text-slate-900 mb-6 uppercase tracking-widest text-xs">Navegación</h5>
                    <ul class="space-y-4">
                        <li><a class="text-slate-500 hover:text-emerald-600 transition-colors text-sm font-medium" href="#">Listados</a></li>
                        <li><a class="text-slate-500 hover:text-emerald-600 transition-colors text-sm font-medium" href="#">Vende con nosotros</a></li>
                        <li><a class="text-slate-500 hover:text-emerald-600 transition-colors text-sm font-medium" href="#">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h5 class="font-bold text-slate-900 mb-6 uppercase tracking-widest text-xs">Oficinas</h5>
                    <ul class="space-y-4">
                        <li><a class="text-slate-500 hover:text-emerald-600 text-sm font-medium" href="#">Mérida, México</a></li>
                        <li><a class="text-slate-500 hover:text-emerald-600 text-sm font-medium" href="#">Veracruz, México</a></li>
                    </ul>
                </div>
            </div>
            <div class="pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center w-full gap-4">
                <p class="text-xs uppercase tracking-widest text-slate-400">© 2024 EstateArchitect. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>
</Layout>
