---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import About from '../components/About.astro';
import Developments from '../components/Developments.astro';
import type { Property } from '../components/PropertyCard.astro';

// FETCH EN VIVO: Astro pedirá estos datos a tu servidor cada vez que se construya el sitio
let properties: Property[] = [];
let locations: string[] = [];
let types: string[] = [];

try {
    const response = await fetch('https://orcic.mx/api-properties.php');
    if (!response.ok) throw new Error('Error al obtener propiedades');
    properties = await response.json();
    
    if ('error' in properties) {
        properties = [];
    } else {
        // Extraemos ubicaciones y tipos ÚNICOS de la data real
        locations = [...new Set(properties.map(p => p.city))].filter(Boolean).sort();
        types = [...new Set(properties.map(p => p.category))].filter(Boolean).sort();
    }
} catch (e) {
    console.error('Fetch error:', e);
    properties = [];
}

// IMPORT DATA DESDE EL CEREBRO CENTRAL
import homeData from '/src/data/homeData.json';
---

<Layout title="ORCIC | Inversión y Legado Inmobiliario">
	<!-- Top Navigation Bar -->
    <header class="fixed top-0 w-full z-50 bg-white shadow-sm border-b border-slate-100 duration-300">
        <div class="flex items-center justify-between px-8 h-22 max-w-7xl mx-auto py-4">
            <div class="flex items-center gap-12">
                <a class="flex items-center gap-3 group" href="/">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain group-hover:scale-105 transition-transform" fetchpriority="high" loading="eager" />
                </a>
                <nav class="hidden lg:flex items-center space-x-10">
                    <a class="text-orcic-blue font-bold border-b-2 border-orcic-blue font-['Manrope'] text-sm tracking-tight transition-colors" href="#catalog">Propiedades</a>
                    <a class="text-slate-700 font-bold font-['Manrope'] text-sm tracking-tight hover:text-orcic-blue transition-colors" href="#desarrollos">Desarrollos</a>
                    <a class="text-slate-700 font-bold font-['Manrope'] text-sm tracking-tight hover:text-orcic-blue transition-colors" href="#nosotros">Nosotros</a>
                    <a class="text-slate-700 font-bold font-['Manrope'] text-sm tracking-tight hover:text-orcic-blue transition-colors" href="#">Contacto</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <button class="bg-[#0b213b] text-white px-8 py-3 rounded-lg font-bold hover:bg-orcic-blue shadow-lg shadow-[#0b213b]/10 transition-all active:scale-95 text-sm font-['Manrope'] tracking-tight">
                    Contactar Ahora
                </button>
            </div>
        </div>
    </header>

	<main>
		<!-- Hero Section -->
		<section class="relative min-h-[100vh] flex items-center pt-24 overflow-hidden bg-[#0b213b]">
			<div class="absolute inset-0 z-0">
				<img 
                    class="w-full h-full object-cover" 
                    src={homeData.hero.imageUrl} 
                    alt="Mediterráneo Residencial - ORCIC"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                />
				<div class="absolute inset-0 bg-gradient-to-r from-[#0b213b]/85 via-[#0b213b]/40 to-transparent"></div>
			</div>
			<div class="relative z-10 w-full max-w-7xl mx-auto px-8 py-24 flex flex-col items-start">
				<!-- Bloque de Texto (Marca a la Izquierda) -->
                <div class="max-w-3xl text-left text-white mb-20">
                    <span class="inline-block px-4 py-1.5 bg-orcic-blue/20 backdrop-blur-md rounded-full text-white text-[10px] font-black uppercase tracking-[0.3em] mb-10 border border-white/10 shadow-sm leading-none">{homeData.hero.badge}</span>
					<h1 class="text-6xl md:text-8xl font-['Manrope'] font-black leading-[1.05] tracking-tighter mb-10 drop-shadow-2xl">
						<Fragment set:html={homeData.hero.title} />
					</h1>
					<p class="text-xl text-white/90 max-w-xl leading-relaxed font-semibold drop-shadow-lg">
						{homeData.hero.subtitle}
					</p>
                </div>
					
                <!-- Glassbox Search Bar -->
                <div class="w-full flex justify-center">
                    <div class="bg-white/5 backdrop-blur-3xl p-1.5 rounded-xl border border-white/10 shadow-2xl w-full max-w-5xl relative z-20">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-0 items-center">
                            <div class="px-8 py-6 flex flex-col border-r border-white/5">
                                <label class="text-[9px] uppercase tracking-[0.25em] text-white/40 mb-2 font-bold">Ubicación</label>
                                <select id="search-location" class="bg-transparent border-none p-0 text-white focus:ring-0 font-medium appearance-none cursor-pointer text-sm">
                                    <option class="text-slate-900" value="all">Todas las zonas</option>
                                    {locations.map(loc => (
                                        <option class="text-slate-900" value={loc}>{loc}</option>
                                    ))}
                                </select>
                            </div>
                            <div class="px-8 py-6 flex flex-col border-r border-white/5">
                                <label class="text-[9px] uppercase tracking-[0.25em] text-white/40 mb-2 font-bold">Tipo</label>
                                <select id="search-type" class="bg-transparent border-none p-0 text-white focus:ring-0 font-medium appearance-none cursor-pointer text-sm">
                                    <option class="text-slate-900" value="all">Cualquier tipo</option>
                                    {types.map(t => (
                                        <option class="text-slate-900" value={t}>{t}</option>
                                    ))}
                                </select>
                            </div>
                            <div class="px-8 py-6 flex flex-col border-r border-white/5">
                                <label class="text-[9px] uppercase tracking-[0.25em] text-white/40 mb-2 font-bold">Presupuesto</label>
                                <select id="search-price" class="bg-transparent border-none p-0 text-white focus:ring-0 font-medium appearance-none cursor-pointer text-sm">
                                    <option class="text-slate-900" value="all">Cualquier precio</option>
                                    <option class="text-slate-900" value="1-5M">$1M - $5M MXN</option>
                                    <option class="text-slate-900" value="5-10M">$5M - $10M MXN</option>
                                    <option class="text-slate-900" value="10M+">$10M+ MXN</option>
                                </select>
                            </div>
                            <div class="px-6 py-6 flex items-center justify-center">
                                <button id="search-btn" class="w-full bg-[#0b213b] text-white h-12 rounded-lg font-bold flex items-center justify-center gap-3 hover:bg-orcic-blue transition-all duration-500 group shadow-lg">
                                    <span class="material-symbols-outlined text-xl group-hover:scale-110 transition-transform">search</span>
                                    <span class="uppercase tracking-widest text-[10px]">Buscar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
			</div>
		</section>

        <!-- Sección Quiénes Somos (Video) -->
        <About />

        <!-- Sección Nuestros Desarrollos (Bento Grid) -->
        <Developments />

		<!-- Featured Properties Gallery -->
		<section id="catalog" class="py-32 bg-white px-8">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
					<div class="max-w-xl">
						<span class="text-orcic-blue font-black tracking-[0.3em] text-[10px] uppercase mb-4 block">Bienes Raíces de Alta Gama</span>
						<h2 class="text-5xl md:text-6xl font-['Manrope'] font-black text-slate-900 leading-[1.1] tracking-tight">Portafolio <br/> <span class="text-orcic-blue italic">Estratégico.</span></h2>
					</div>
					<a class="bg-slate-50 px-8 py-4 rounded-xl border border-slate-100 text-slate-900 font-bold flex items-center gap-3 hover:bg-white hover:border-orcic-blue transition-all shadow-sm group" href="#">
						Ver Catálogo Completo <span class="material-symbols-outlined text-orcic-blue group-hover:translate-x-1 transition-transform">arrow_forward</span>
					</a>
				</div>
                
                <div id="property-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                    {properties.map((prop) => (
                        <div class="property-item" data-location={prop.city} data-type={prop.category}>
                            <PropertyCard property={prop} />
                        </div>
                    ))}
                </div>

                <!-- Buscador Vacío (Oculto por defecto) -->
                <div id="no-results" class="hidden text-center py-32 bg-slate-50 rounded-[3rem] border border-slate-100 shadow-inner mt-12">
                    <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-slate-300">search_off</span>
                    </div>
                    <p class="text-slate-900 font-black text-xl font-['Manrope']">No encontramos propiedades</p>
                    <p class="text-slate-400 text-sm mt-2 max-w-xs mx-auto">Prueba ajustando los filtros de búsqueda para encontrar tu espacio ideal.</p>
                </div>
			</div>
		</section>

        <script is:inline>
            document.getElementById('search-btn')?.addEventListener('click', () => {
                const locSelect = document.getElementById('search-location');
                const typeSelect = document.getElementById('search-type');
                const selectedLoc = locSelect.value;
                const selectedType = typeSelect.value;
                
                const items = document.querySelectorAll('.property-item');
                const noResults = document.getElementById('no-results');
                
                let found = 0;

                items.forEach(item => {
                    const itemLoc = item.dataset.location;
                    const itemType = item.dataset.type;
                    
                    const locMatch = selectedLoc === 'all' || itemLoc === selectedLoc;
                    const typeMatch = selectedType === 'all' || itemType === selectedType;

                    if (locMatch && typeMatch) {
                        item.style.display = 'block';
                        found++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (found === 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }

                // Scroll suave a los resultados
                document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
            });
        </script>
	</main>

	<!-- Footer -->
    <footer class="w-full border-t border-slate-100 bg-slate-50">
        <div class="max-w-7xl mx-auto px-8 py-24">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-16 mb-20">
                <div class="md:col-span-5">
                    <img src="/logo_orcic.png" alt="ORCIC" class="h-16 w-auto object-contain mb-8" loading="lazy" />
                    <p class="text-slate-500 max-w-sm mb-10 leading-relaxed font-medium">Lideramos el mercado de bienes raíces industriales y de lujo con un enfoque en ingeniería, integridad y resultados excepcionales en todo México.</p>
                    <div class="flex gap-4">
                        <a href="#" class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-slate-900 border border-slate-100 hover:bg-orcic-blue hover:text-white transition-all shadow-sm"><span class="material-symbols-outlined">share</span></a>
                        <a href="#" class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-slate-900 border border-slate-100 hover:bg-orcic-blue hover:text-white transition-all shadow-sm"><span class="material-symbols-outlined">mail</span></a>
                    </div>
                </div>
                <div class="md:col-span-2">
                    <h5 class="font-black text-slate-900 mb-8 uppercase tracking-[0.2em] text-[10px]">Menú</h5>
                    <ul class="space-y-4">
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-bold" href="#nosotros">Nosotros</a></li>
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-bold" href="#catalog">Propiedades</a></li>
                        <li><a class="text-slate-500 hover:text-orcic-blue transition-colors text-sm font-bold" href="#desarrollos">Desarrollos</a></li>
                    </ul>
                </div>
                <div class="md:col-span-2">
                    <h5 class="font-black text-slate-900 mb-8 uppercase tracking-[0.2em] text-[10px]">Zonas</h5>
                    <ul class="space-y-4">
                        <li><span class="text-slate-500 text-sm font-bold block">Mérida, YUC.</span></li>
                        <li><span class="text-slate-500 text-sm font-bold block">Veracruz, VER.</span></li>
                    </ul>
                </div>
                <div class="md:col-span-3">
                    <h5 class="font-black text-slate-900 mb-8 uppercase tracking-[0.2em] text-[10px]">Soporte ORCIC</h5>
                    <button class="w-full bg-[#0b213b] text-white py-4 rounded-xl font-bold hover:bg-orcic-blue transition-all mb-4 shadow-xl">Contactar con Asesor</button>
                    <p class="text-slate-400 text-[10px] text-center uppercase tracking-widest font-bold">Disponibilidad 24/7 vía WhatsApp</p>
                </div>
            </div>
            <div class="pt-12 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center w-full gap-8">
                <p class="text-[10px] uppercase tracking-[0.3em] text-slate-400 font-black text-center md:text-left">© 2024 ORCIC INMOBILIARIA. <span class="hidden md:inline">|</span> Legado e Ingeniería Inmobiliaria.</p>
                <div class="flex gap-8">
                    <a href="#" class="text-[10px] uppercase tracking-[0.3em] text-slate-400 hover:text-orcic-blue transition-colors font-black">Aviso de Privacidad</a>
                    <a href="#" class="text-[10px] uppercase tracking-[0.3em] text-slate-400 hover:text-orcic-blue transition-colors font-black">Términos</a>
                </div>
            </div>
        </div>
    </footer>
</Layout>
