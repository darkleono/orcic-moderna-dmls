---
interface Location {
    id: number;
    description: string;
    properties_count: number;
    image?: string;
}

import { fetchProperties } from '../lib/api';

const data = await fetchProperties();

// Extraer ubicaciones únicas y contar propiedades
const locationMap: Record<string, Location> = {};
data.forEach((prop: any) => {
    if (!locationMap[prop.city]) {
        locationMap[prop.city] = {
            id: prop.id,
            description: prop.city,
            properties_count: 0,
            image: prop.images && prop.images[0] ? `https://orcic.mx/storage/${prop.images[0]}` : '' // Fallback imagen
        };
    }
    locationMap[prop.city].properties_count++;
});

const locations = Object.values(locationMap).slice(0, 4); 
---

<section id="desarrollos" class="py-24 bg-slate-50 overflow-hidden">
    <div class="container mx-auto px-6">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
            <div data-aos="fade-up">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-orcic-blue/5 border border-orcic-blue/10">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em] text-orcic-blue">Proyectos e Ingeniería</span>
                </div>
                <h2 class="text-4xl lg:text-5xl font-black font-['Manrope'] text-slate-900 leading-tight">
                    Nuestros <br/> <span class="text-orcic-blue italic">Desarrollos.</span>
                </h2>
            </div>
            <p class="max-w-md text-slate-500 font-medium text-lg leading-relaxed" data-aos="fade-up" data-aos-delay="100">
                Presencia estratégica en los polos de desarrollo industrial y residencial más importantes de México.
            </p>
        </div>

        <!-- Bento Grid Layout -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 h-auto md:h-[600px]">
            
            {locations.map((loc, index) => {
                // Definir clases de rejilla para el efecto Bento
                const gridClasses = [
                    "md:col-span-8 md:row-span-1", // 1er item (Mérida?)
                    "md:col-span-4 md:row-span-2", // 2do item (Largo vertical)
                    "md:col-span-4 md:row-span-1", // 3er item
                    "md:col-span-4 md:row-span-1"  // 4to item
                ][index] || "md:col-span-4";

                return (
                    <div class={`${gridClasses} group relative rounded-3xl overflow-hidden cursor-pointer shadow-xl transition-all duration-700 hover:-translate-y-2`} data-aos="zoom-in" data-aos-delay={index * 100}>
                        <!-- Fondo con imagen real -->
                        <img 
                            src={loc.image} 
                            alt={loc.description} 
                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent"></div>
                        
                        <!-- Contenido -->
                        <div class="absolute inset-0 p-8 flex flex-col justify-end">
                            <span class="text-white/60 text-[10px] font-black uppercase tracking-widest mb-2 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full self-start">
                                {loc.properties_count} Propiedades
                            </span>
                            <h3 class="text-white text-3xl font-black font-['Manrope'] mb-2 uppercase tracking-wide group-hover:text-orcic-blue transition-colors">
                                {loc.description}
                            </h3>
                            <div class="flex items-center gap-2 text-white/40 text-xs font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500">
                                Explorar Zona <span class="material-symbols-outlined text-sm">east</span>
                            </div>
                        </div>

                        <!-- Borde Premium -->
                        <div class="absolute inset-0 border border-white/10 group-hover:border-orcic-blue/30 transition-colors pointer-events-none rounded-3xl"></div>
                    </div>
                );
            })}

        </div>

        <div class="mt-16 text-center" data-aos="fade-up">
            <a href="/propiedades" class="inline-flex items-center gap-3 text-[#0b213b] font-black uppercase text-[11px] tracking-[0.4em] hover:text-orcic-blue transition-colors group">
                Ver todos los desarrollos <span class="material-symbols-outlined text-lg group-hover:translate-x-2 transition-transform">arrow_forward</span>
            </a>
        </div>

    </div>
</section>
