---
---
<section id="nosotros" class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            
            <!-- Bloque de Texto -->
            <div class="lg:w-1/2" data-aos="fade-right">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-orcic-blue/5 border border-orcic-blue/10">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em] text-orcic-blue">Consorcio Industrial</span>
                </div>
                
                <h2 class="text-5xl lg:text-6xl font-black font-['Manrope'] text-slate-900 leading-[1.1] mb-8">
                    Tu Legado, <br/>
                    <span class="text-orcic-blue italic">Nuestra Ingeniería.</span>
                </h2>
                
                <div class="space-y-6 text-slate-600 text-lg leading-relaxed font-medium">
                    <p>
                        En <span class="font-bold text-slate-900">ORCIC</span>, no solo construimos estructuras; forjamos el escenario donde se desarrolla tu futuro. Con décadas de experiencia en el sector industrial y residencial, hemos perfeccionado el arte de combinar la robustez de la ingeniería con la elegancia del diseño moderno.
                    </p>
                    <p>
                        Nuestra misión es simple pero ambiciosa: ofrecer soluciones inmobiliarias que trasciendan generaciones, garantizando plusvalía y seguridad en cada metro cuadrado que desarrollamos.
                    </p>
                </div>

                <div class="mt-12 flex flex-wrap gap-8">
                    <div class="flex flex-col">
                        <span class="text-4xl font-black text-orcic-blue leading-none">20+</span>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mt-2">Años de Trayectoria</span>
                    </div>
                    <div class="w-px h-12 bg-slate-100 hidden sm:block"></div>
                    <div class="flex flex-col">
                        <span class="text-4xl font-black text-orcic-blue leading-none">500+</span>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mt-2">Proyectos Entregados</span>
                    </div>
                </div>
            </div>

            <!-- Bloque de Video -->
            <div class="lg:w-1/2 relative" data-aos="fade-left">
                <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl bg-slate-900 aspect-video group" id="video-container">
                    
                    <!-- Video Real de ORCIC -->
                    <video 
                        id="video-about"
                        class="absolute inset-0 w-full h-full object-cover"
                        muted 
                        playsinline
                    >
                        <source src="https://orcic.mx/video/video-1.mp4" type="video/mp4">
                        Tu navegador no soporta el video.
                    </video>

                    <!-- Semi-glass Controls Overlay -->
                    <div id="video-controls" class="absolute bottom-6 left-6 right-6 flex items-center justify-between px-6 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl opacity-0 transition-all duration-500 z-30">
                        <div class="flex items-center gap-5">
                            <button id="ctrl-play" class="text-white hover:scale-110 transition-transform flex items-center">
                                <span class="material-symbols-outlined fill-current text-2xl" id="play-icon-main">play_arrow</span>
                            </button>
                            <div class="h-4 w-px bg-white/20"></div>
                            <button id="ctrl-volume" class="text-white hover:scale-110 transition-transform flex items-center">
                                <span class="material-symbols-outlined text-2xl" id="volume-icon">volume_off</span>
                            </button>
                        </div>
                        
                        <div class="flex items-center gap-5">
                            <button id="ctrl-fullscreen" class="text-white hover:scale-110 transition-transform flex items-center">
                                <span class="material-symbols-outlined text-2xl">fullscreen</span>
                            </button>
                        </div>
                    </div>

                    <!-- Overlay central para click (Play gigante suave) -->
                    <div id="video-click-overlay" class="absolute inset-0 flex items-center justify-center cursor-pointer z-20 transition-all duration-500">
                        <div id="center-btn" class="w-20 h-20 bg-white/10 backdrop-blur-xl rounded-full flex items-center justify-center border border-white/20 scale-90 opacity-0 transition-all duration-500">
                             <span id="center-play-icon" class="material-symbols-outlined text-white text-4xl fill-current">play_arrow</span>
                        </div>
                    </div>
                </div>

                <!-- Elemento Decorativo Asimétrico -->
                <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-orcic-blue/5 rounded-full blur-3xl -z-10"></div>
                <div class="absolute -top-10 -left-10 w-32 h-32 border border-slate-100 rounded-full -z-10 animate-pulse"></div>
            </div>

        </div>
    </div>
</section>

<script>
    const video = document.getElementById('video-about') as HTMLVideoElement;
    const container = document.getElementById('video-container');
    const controls = document.getElementById('video-controls');
    const playBtn = document.getElementById('ctrl-play');
    const playIcon = document.getElementById('play-icon-main');
    const centerBtn = document.getElementById('center-btn');
    const centerIcon = document.getElementById('center-play-icon');
    const volumeBtn = document.getElementById('ctrl-volume');
    const volumeIcon = document.getElementById('volume-icon');
    const fullscreenBtn = document.getElementById('ctrl-fullscreen');
    const clickOverlay = document.getElementById('video-click-overlay');

    if (video && container && controls) {
        let loopCount = 0;
        const maxLoops = 3;
        let hideTimeout: number;
        video.volume = 0.5;

        // --- LÓGICA DE AUTO-OCULTADO ---
        const showControls = () => {
            controls.classList.remove('opacity-0');
            controls.classList.add('opacity-100');
            
            clearTimeout(hideTimeout);
            
            // Solo auto-ocultar si el video está reproduciéndose
            if (!video.paused) {
                hideTimeout = window.setTimeout(() => {
                    controls.classList.add('opacity-0');
                    controls.classList.remove('opacity-100');
                }, 3000);
            }
        };

        container.addEventListener('mousemove', showControls);
        container.addEventListener('mouseenter', showControls);

        // 1. Intersection Observer para Autoplay cuando se ve
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (loopCount < maxLoops) {
                        video.play().catch(() => console.log("Playback prevented by browser"));
                    }
                } else {
                    video.pause();
                }
            });
        }, { threshold: 0.5 });

        observer.observe(video);

        // 2. Play / Pause Logic
        const togglePlay = () => {
            if (video.paused) {
                video.play();
                updateUIState(true);
                showControls();
            } else {
                video.pause();
                updateUIState(false);
                showControls();
            }
        };

        const updateUIState = (playing: boolean) => {
            if (playing) {
                if (playIcon) playIcon.innerText = 'pause';
                if (centerIcon) centerIcon.innerText = 'pause';
                if (centerBtn) {
                    centerBtn.classList.add('opacity-0', 'scale-110');
                    centerBtn.classList.remove('opacity-100', 'scale-90');
                }
            } else {
                if (playIcon) playIcon.innerText = 'play_arrow';
                if (centerIcon) centerIcon.innerText = 'play_arrow';
                if (centerBtn) {
                    centerBtn.classList.remove('opacity-0', 'scale-110');
                    centerBtn.classList.add('opacity-100', 'scale-90');
                }
            }
        };

        playBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            togglePlay();
        });
        clickOverlay?.addEventListener('click', togglePlay);

        // 3. Volume Control
        volumeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            video.muted = !video.muted;
            if (volumeIcon) {
                volumeIcon.innerText = video.muted ? 'volume_off' : 'volume_up';
            }
            showControls();
        });

        // 4. Fullscreen
        fullscreenBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => {
                    console.error(`Error en fullscreen: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
            showControls();
        });

        // 5. Loop Counter (Máximo 3)
        video.addEventListener('ended', () => {
            loopCount++;
            if (loopCount < maxLoops) {
                video.currentTime = 0;
                video.play();
            } else {
                video.pause();
                updateUIState(false);
                showControls();
            }
        });

        // Sincronización de UI con eventos de video
        video.addEventListener('play', () => {
            updateUIState(true);
            showControls();
        });
        video.addEventListener('pause', () => {
            updateUIState(false);
            showControls();
        });
    }
</script>
