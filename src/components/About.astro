---
import homeData from '/src/data/homeData.json';
---
<section id="nosotros" class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            
            <!-- Bloque de Texto -->
            <div class="lg:w-1/2" data-aos="fade-right">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-orcic-blue/5 border border-orcic-blue/10">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em] text-orcic-blue">Consorcio Industrial</span>
                </div>
                
                <h2 class="text-5xl lg:text-6xl font-black font-['Manrope'] text-slate-900 leading-[1.1] mb-8">
                    <Fragment set:html={homeData.ethos[1].title.replace(', ', ', <br/>')} />
                </h2>
                
                <div class="space-y-6 text-slate-600 text-lg leading-relaxed font-medium">
                    <p>
                        {homeData.ethos[1].content}
                    </p>
                </div>

                <div class="mt-12 flex flex-wrap gap-8">
                    <div class="flex flex-col">
                        <span class="text-4xl font-black text-orcic-blue leading-none">{homeData.stats[0].value}</span>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mt-2">{homeData.stats[0].label}</span>
                    </div>
                    <div class="w-px h-12 bg-slate-100 hidden sm:block"></div>
                    <div class="flex flex-col">
                        <span class="text-4xl font-black text-orcic-blue leading-none">{homeData.stats[1].value}</span>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mt-2">{homeData.stats[1].label}</span>
                    </div>
                </div>
            </div>

            <!-- Bloque de Video -->
            <div class="lg:w-1/2 relative" data-aos="fade-left">
                <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl bg-slate-900 aspect-video group" id="video-container">
                    
                    <!-- Video Real de ORCIC -->
                    <video 
                        id="video-about"
                        class="absolute inset-0 w-full h-full object-cover"
                        muted 
                        playsinline
                    >
                        <source src="https://orcic.mx/video/video-1.mp4" type="video/mp4">
                        Tu navegador no soporta el video.
                    </video>

                    <!-- Subtly darker semi-glass Controls Overlay (ORCIC Navy) -->
                    <div id="video-controls" class="absolute bottom-6 left-6 right-6 flex items-center justify-between px-6 py-3 bg-orcic-navy/30 backdrop-blur-xl border border-white/10 rounded-2xl opacity-0 transition-all duration-500 z-30 shadow-2xl">
                        <div class="flex items-center gap-5">
                            <button id="ctrl-play" class="text-white hover:text-orcic-blue transition-all flex items-center drop-shadow-md">
                                <span class="material-symbols-outlined fill-current text-2xl" id="play-icon-main">play_arrow</span>
                                <span class="material-symbols-outlined fill-current text-2xl hidden" id="pause-icon-main">pause</span>
                            </button>
                            <div class="h-4 w-px bg-white/10"></div>
                            <button id="ctrl-volume" class="text-white hover:text-orcic-blue transition-all flex items-center drop-shadow-md">
                                <span class="material-symbols-outlined text-2xl" id="vol-off-icon">volume_off</span>
                                <span class="material-symbols-outlined text-2xl hidden" id="vol-on-icon">volume_up</span>
                            </button>
                        </div>
                        
                        <div class="flex items-center gap-5">
                            <button id="ctrl-fullscreen" class="text-white hover:text-orcic-blue transition-all flex items-center drop-shadow-md">
                                <span class="material-symbols-outlined text-2xl">fullscreen</span>
                            </button>
                        </div>
                    </div>

                    <!-- Overlay central para click con mayor definición -->
                    <div id="video-click-overlay" class="absolute inset-0 flex items-center justify-center cursor-pointer z-20 transition-all duration-500">
                        <div id="center-btn" class="w-20 h-20 bg-orcic-navy/20 backdrop-blur-2xl rounded-full flex items-center justify-center border border-white/20 scale-90 opacity-0 transition-all duration-500 shadow-xl">
                             <span id="center-play-icon" class="material-symbols-outlined text-white text-4xl fill-current drop-shadow-lg">play_arrow</span>
                             <span id="center-pause-icon" class="material-symbols-outlined text-white text-4xl fill-current drop-shadow-lg hidden">pause</span>
                        </div>
                    </div>
                </div>

                <!-- Elemento Decorativo Asimétrico -->
                <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-orcic-blue/5 rounded-full blur-3xl -z-10"></div>
                <div class="absolute -top-10 -left-10 w-32 h-32 border border-slate-100 rounded-full -z-10 animate-pulse"></div>
            </div>

        </div>
    </div>
</section>

<script>
    const video = document.getElementById('video-about') as HTMLVideoElement;
    const container = document.getElementById('video-container');
    const controls = document.getElementById('video-controls');
    
    // Icons
    const playIcon = document.getElementById('play-icon-main');
    const pauseIcon = document.getElementById('pause-icon-main');
    const centerPlayIcon = document.getElementById('center-play-icon');
    const centerPauseIcon = document.getElementById('center-pause-icon');
    const volOffIcon = document.getElementById('vol-off-icon');
    const volOnIcon = document.getElementById('vol-on-icon');

    const playBtn = document.getElementById('ctrl-play');
    const centerBtn = document.getElementById('center-btn');
    const volumeBtn = document.getElementById('ctrl-volume');
    const fullscreenBtn = document.getElementById('ctrl-fullscreen');
    const clickOverlay = document.getElementById('video-click-overlay');

    if (video && container && controls) {
        let loopCount = 0;
        const maxLoops = 3;
        let hideTimeout: number;
        video.volume = 0.5;

        // --- LÓGICA DE AUTO-OCULTADO ---
        const showControls = () => {
            controls.classList.remove('opacity-0');
            controls.classList.add('opacity-100');
            clearTimeout(hideTimeout);
            if (!video.paused) {
                hideTimeout = window.setTimeout(() => {
                    controls.classList.add('opacity-0');
                    controls.classList.remove('opacity-100');
                }, 3000);
            }
        };

        container.addEventListener('mousemove', showControls);
        container.addEventListener('mouseenter', showControls);

        // 1. Intersection Observer con Bloqueo de Re-entrada
        let isProcessing = false;
        const observer = new IntersectionObserver((entries) => {
            if (isProcessing) return;
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (loopCount < maxLoops && video.paused) {
                        isProcessing = true;
                        video.play().finally(() => { isProcessing = false; });
                    }
                } else {
                    if (!video.paused) video.pause();
                }
            });
        }, { threshold: 0.1 });

        observer.observe(video);

        // 2. Play / Pause Logic (Usando clases, evitar mutación de texto)
        const togglePlay = () => {
            if (video.paused) video.play();
            else video.pause();
            showControls();
        };

        const updateUIState = (playing: boolean) => {
            // Toggle de iconos sin mutar texto (evita Reflow)
            if (playing) {
                playIcon?.classList.add('hidden');
                pauseIcon?.classList.remove('hidden');
                centerPlayIcon?.classList.add('hidden');
                centerPauseIcon?.classList.remove('hidden');
                centerBtn?.classList.add('opacity-0', 'scale-110');
            } else {
                playIcon?.classList.remove('hidden');
                pauseIcon?.classList.add('hidden');
                centerPlayIcon?.classList.remove('hidden');
                centerPauseIcon?.classList.add('hidden');
                centerBtn?.classList.remove('opacity-0', 'scale-110');
                centerBtn?.classList.add('opacity-100', 'scale-90');
            }
        };

        playBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            togglePlay();
        });
        clickOverlay?.addEventListener('click', togglePlay);

        // 3. Volume Control (Usando clases, evitar mutación de texto)
        volumeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            video.muted = !video.muted;
            if (video.muted) {
                volOffIcon?.classList.remove('hidden');
                volOnIcon?.classList.add('hidden');
            } else {
                volOffIcon?.classList.add('hidden');
                volOnIcon?.classList.remove('hidden');
            }
            showControls();
        });

        // 4. Fullscreen
        fullscreenBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => {
                    console.error(`Error en fullscreen: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
            showControls();
        });

        // 5. Loop Counter (Máximo 3)
        video.addEventListener('ended', () => {
            loopCount++;
            if (loopCount < maxLoops) {
                video.currentTime = 0;
                video.play();
            } else {
                video.pause();
                updateUIState(false);
                showControls();
            }
        });

        // Sincronización de UI con eventos de video
        video.addEventListener('play', () => {
            updateUIState(true);
            showControls();
        });
        video.addEventListener('pause', () => {
            updateUIState(false);
            showControls();
        });
    }
</script>
