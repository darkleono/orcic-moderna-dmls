---
export interface Property {
    id: number;
    code: string;
    name: string;
    description: string;
    price: string;
    area: string;
    num_rooms: string | number;
    num_bathrooms: string | number;
    category: string;
    status: string;
    city: string;
    images: string[];
    features: string[];
}

interface Props {
    property: Property;
}

const { property } = Astro.props;

// Normalizar la imagen para que use la ruta correcta de storage de Laravel
const mainImage = property.images && property.images.length > 0 
    ? `https://orcic.mx/storage/${property.images[0]}`
    : '/storage/placeholder.svg';

// Formateador de precio
const formatter = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  minimumFractionDigits: 0,
});

const formattedPrice = property.price ? formatter.format(parseFloat(property.price)) : "Consultar Precio";
---

<div class="group bg-white rounded-2xl overflow-hidden border border-slate-100 hover:border-orcic-blue/20 shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col h-full relative">
    
    <!-- Imagen y Tags -->
    <div class="relative aspect-[4/3] overflow-hidden">
        <img 
            src={mainImage} 
            alt={property.name}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-60"></div>
        
        <div class="absolute top-4 left-4 flex gap-2">
            <span class="bg-[#0b213b] text-white px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest shadow-lg">
                {property.status}
            </span>
            <span class="bg-white/90 backdrop-blur-md text-slate-800 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest shadow-lg">
                {property.category}
            </span>
        </div>
        
        <div class="absolute bottom-4 left-4">
             <div class="flex items-center gap-1.5 text-white">
                <span class="material-symbols-outlined text-sm">location_on</span>
                <span class="text-xs font-bold tracking-wide uppercase">{property.city}</span>
            </div>
        </div>
    </div>
    
    <!-- Contenido -->
    <div class="p-6 flex flex-col flex-grow">
        <h4 class="text-lg font-black font-['Manrope'] text-slate-900 mb-2 group-hover:text-orcic-blue transition-colors line-clamp-1">
            {property.name}
        </h4>
        
        <p class="text-orcic-blue font-black text-xl mb-6">
            {formattedPrice}
        </p>
        
        <!-- Ficha Técnica -->
        <div class="grid grid-cols-3 gap-2 pt-6 border-t border-slate-50 mt-auto">
            <div class="flex flex-col items-center gap-1 border-r border-slate-50">
                <span class="material-symbols-outlined text-slate-300 text-xl">bed</span>
                <span class="text-[11px] font-bold text-slate-600 uppercase tracking-tighter">{property.num_rooms} Recs.</span>
            </div>
            <div class="flex flex-col items-center gap-1 border-r border-slate-50">
                <span class="material-symbols-outlined text-slate-300 text-xl">bathtub</span>
                <span class="text-[11px] font-bold text-slate-600 uppercase tracking-tighter">{property.num_bathrooms} Baños</span>
            </div>
            <div class="flex flex-col items-center gap-1">
                <span class="material-symbols-outlined text-slate-300 text-xl">architecture</span>
                <span class="text-[11px] font-bold text-slate-600 uppercase tracking-tighter">{property.area} m²</span>
            </div>
        </div>
    </div>

    <!-- Overlay de Acción (Stitch Style) -->
    <div class="absolute inset-0 bg-[#0b213b]/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 text-center backdrop-blur-sm z-30">
        <span class="text-white/60 text-[10px] uppercase tracking-[0.3em] font-bold mb-4">Código: {property.code}</span>
        <h5 class="text-white text-xl font-black mb-8">{property.name}</h5>
        <a href={`/propiedad/${property.code}`} class="bg-white text-[#0b213b] px-8 py-3 rounded-xl font-bold uppercase text-[10px] tracking-widest hover:bg-orcic-blue hover:text-white transition-all shadow-2xl">
            Ver Detalles
        </a>
    </div>
</div>
